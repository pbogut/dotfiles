#!/usr/bin/env bash
#=================================================
# name:   run_onchange_before_install-pacman
# author: pbogut <pbogut@pbogut.me>
# date:   06/03/2024
#=================================================
set -e

# {{- if or (not .archlinux) (not .install_system_packages) }} [[[ Do not install
exit 0
# Do not install ]]] {{- end }}
echo "> Update pacman database..."
echo "# pacman -Sy"
sudo pacman -Sy

installed=$(pacman -Q | awk '{print $1}')
should_install_pacman="{{ range .packages.pacman -}}{{ . }} {{ end }}"
# {{- if eq .hostname "silverspoon" }} [[[ silverspoon
should_install_pacman+="{{ range .silverspoon.packages.pacman -}}{{ . }} {{ end }}"
# silverspoon ]]] {{- end }}
to_install_pacman=""

# Loop through the packages to install and check if they are already installed
for package in $should_install_pacman; do
    if ! echo "$installed" | grep -q "^$package$"; then
        to_install_pacman="$to_install_pacman $package"
    fi
done

if [[ $to_install_pacman != "" ]]; then
    echo "To install: $to_install_pacman"
    sudo pacman -S \
        --needed \
        $to_install_pacman
fi
