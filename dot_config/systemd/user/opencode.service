[Unit]
Description=OpenCode background server

[Service]
Type=exec
WorkingDirectory=%h
ExecStart=/usr/bin/mise exec opencode@2 -- opencode serve --service
Environment=PATH=%h/.local/share/mise/shims:%h/.bin:%h/.local/share/nvim/mason/bin:%h/.cargo/bin:%h/.gocode/bin:%h/.local/bin:%h/.scripts:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
