{
  "meetings.enabled": true,
  "meetings.output_folder": "{{ .chezmoi.homeDir }}/Wiki/meetings",
  "meetings.summaries": "opencode",
  "meetings.opencode_model": "openai/gpt-6.1-terra",
  "meetings.retention": "forever",
  "meetings.audio_retention": "week",
  "avoid_bluetooth_microphone": true,
  "release_microphone_while_idle": true,
  "recording_audio_behavior": "pause_media",
  "sound_effects": true,
  "sound_effect_volume": 0.5,
  "sound_theme": "classic",
  "double_tap_lock": true,
  "double_tap_only": false,
  "shortcut_mode": "hold"
}
