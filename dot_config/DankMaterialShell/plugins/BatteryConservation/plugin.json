{
  "id": "batteryConservation",
  "name": "Battery Conservation",
  "description": "Show battery details and control Lenovo IdeaPad conservation mode",
  "version": "1.0.0",
  "author": "Pawel Bogut",
  "type": "composite",
  "capabilities": ["daemon", "dankbar-widget"],
  "components": {
    "daemon": "./BatteryConservationDaemon.qml",
    "widget": "./BatteryConservationWidget.qml"
  },
  "startupCheck": "./StartupCheck.qml",
  "icon": "battery_saver",
  "requires_dms": ">=1.5.0",
  "dependencies": ["ideapad-cm", "pkexec"],
  "permissions": ["process"]
}
