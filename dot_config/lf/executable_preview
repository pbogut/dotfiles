#!/bin/sh

image() {
    if [ ! -z "$UB_SOCKET" ]; then
        x=$4
        y=$5
        max_width=$(($2 - 1))
        max_height=$3
        if [ "${HERDR_ENV:-}" = 1 ] && [ "${UB_CLIENT_WIDTH:-0}" -gt 0 ] && [ "${UB_CLIENT_HEIGHT:-0}" -gt 0 ]; then
            # The Wayland layer uses full-terminal pixels while its PTY reports pane cells.
            x=$((((x + UB_PANE_X) * UB_PANE_WIDTH + UB_CLIENT_WIDTH / 2) / UB_CLIENT_WIDTH))
            y=$((((y + UB_PANE_Y) * UB_PANE_HEIGHT + UB_CLIENT_HEIGHT / 2) / UB_CLIENT_HEIGHT))
            max_width=$(((max_width * UB_PANE_WIDTH + UB_CLIENT_WIDTH / 2) / UB_CLIENT_WIDTH))
            max_height=$(((max_height * UB_PANE_HEIGHT + UB_CLIENT_HEIGHT / 2) / UB_CLIENT_HEIGHT))
        fi
        ueberzugpp cmd \
                -s "$UB_SOCKET" \
                -a add \
                -i PREVIEW \
                -x "$x" \
                -y "$y" \
                --max-width "$max_width" \
                --max-height "$max_height" \
                -f "$1"
        # HAS HERDR
    elif [ ! -z "$HERDR_ENV" ]; then
        file=$1
        w=$2
        h=$3
        # x=$4
        # y=$5
        # kitty +kitten icat --silent --stdin no --transfer-mode file --place "${w}x${h}@${x}x${y}" "$1" </dev/null >/dev/tty
        # wezterm imgcat "$file" --width "$w" --height "$h" --position "$x,$y" < /dev/null > /dev/tty
        chafa -s "${w}x${h}" --animate off --polite on "$file"
    else
        file=$1
        w=$2
        h=$3
        # x=$4
        # y=$5
        # kitty +kitten icat --silent --stdin no --transfer-mode file --place "${w}x${h}@${x}x${y}" "$1" </dev/null >/dev/tty
        # wezterm imgcat "$file" --width "$w" --height "$h" --position "$x,$y" < /dev/null > /dev/tty
        chafa -f sixel -s "${w}x${h}" --animate off --polite on "$file"
     fi
    # Disable lf's preview cache so revisiting an image redraws it.
    exit 1
}

batorcat() {
    file="$1"
    if command -v bat > /dev/null; then
        shift;
        bat --force-colorization --wrap auto --style=plain,header "$file" "$@"
    else
        cat "$file"
    fi
}

glowormdcat() {
    file="$1"
    shift
    if command -v glow > /dev/null 2>&1; then
        glow "$file"
    else
        mdcat "$file"
    fi
}

CACHE="$HOME/.cache/lf/thumbnail.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | awk '{print $1}'))"

if [ "$(head -c34 "$1")" = "xdg-desktop-portal-termfilechooser" ]; then
    batorcat "$1"
    return 0
fi

case "$(printf "%s\n" "$(readlink -f "$1")" | awk '{print tolower($0)}')" in
    *.tgz | *.tar.gz) tar tzf "$1" ;;
    *.tar.bz2 | *.tbz2) tar tjf "$1" ;;
    *.tar.txz | *.txz) xz --list "$1" ;;
    *.tar) tar tf "$1" ;;
    *.zip | *.jar | *.war | *.ear | *.oxt) unzip -l "$1" ;;
    *.rar) unrar l "$1" ;;
    *.md)
        glowormdcat "$1"
        ;;
    *.7z) 7z l "$1" ;;
    *.[1-8]) man "$1" | col -b ;;
    *.o) nm "$1" ;;
    *.torrent) transmission-show "$1" ;;
    *.iso) iso-info --no-header -l "$1" ;;
    *.odt | *.ods | *.odp | *.sxw) odt2txt "$1" ;;
    *.doc) catdoc "$1" ;;
    *.docx) docx2txt "$1" ;;
    *.xml | *.html) w3m -dump "$1" ;;
    *.xls | *.xlsx)
        ssconvert --export-type=Gnumeric_stf:stf_csv "$1" "fd://1" | batorcat --language=csv
        ;;
    *.wav | *.mp3 | *.flac | *.m4a | *.wma | *.ape | *.ac3 | *.og[agx] | *.spx | *.opus | *.as[fx] | *.mka)
        exiftool "$1"
        ;;
    # *.pdf)
    #     # [ ! -f "${CACHE}.txt" ] &&
    #     pdftotext -layout "$1" "${CACHE}.txt"
    #     batorcat "${CACHE}.txt" "$2"
    #     ;;
    *_e_faktura_*.pdf)
        [ ! -f "${CACHE}.jpg" ] &&
            pdftoppm -jpeg -f 2 -singlefile "$1" "$CACHE"
        image "${CACHE}.jpg" "$2" "$3" "$4" "$5"
        ;;
    *.pdf)
        [ ! -f "${CACHE}.jpg" ] &&
            pdftoppm -jpeg -f 1 -singlefile "$1" "$CACHE"
        image "${CACHE}.jpg" "$2" "$3" "$4" "$5"
        ;;
    *.epub)
        [ ! -f "$CACHE" ] &&
            epub-thumbnailer "$1" "$CACHE" 1024
        image "$CACHE" "$2" "$3" "$4" "$5"
        ;;
    *.cbz | *.cbr | *.cbt)
        [ ! -f "$CACHE" ] &&
            comicthumb "$1" "$CACHE" 1024
        image "$CACHE" "$2" "$3" "$4" "$5"
        ;;
    *.avi | *.mp4 | *.wmv | *.dat | *.3gp | *.ogv | *.mkv | *.mpg | *.mpeg | *.vob | *.fl[icv] | *.m2v | *.mov | *.webm | *.ts | *.mts | *.m4v | *.r[am] | *.qt | *.divx)
        [ ! -f "${CACHE}.jpg" ] &&
            ffmpegthumbnailer -i "$1" -o "${CACHE}.jpg" -s 0 -q 5
        image "${CACHE}.jpg" "$2" "$3" "$4" "$5"
        ;;
    *.bmp | *.jpg | *.jpeg | *.png | *.xpm | *.webp | *.tiff | *.gif | *.jfif | *.ico)
        image "$1" "$2" "$3" "$4" "$5"
        ;;
    *.svg)
        [ ! -f "${CACHE}.jpg" ] &&
            convert "$1" "${CACHE}.jpg"
        image "${CACHE}.jpg" "$2" "$3" "$4" "$5"
        ;;
    *.ino)
        batorcat --language=cpp "$1"
        ;;
    *.scad)
        [ ! -f "${CACHE}.png" ] &&
            openscad --render -o "${CACHE}.png" "$1"
        image "${CACHE}.png" "$2" "$3" "$4" "$5"
        ;;
    *.stl)
        [ ! -f "${CACHE}.png" ] &&
            stl-to-png "$1" "${CACHE}.png"
        image "${CACHE}.png" "$2" "$3" "$4" "$5"
        ;;
    *)
        batorcat "$1"
        ;;
esac
exit 0
