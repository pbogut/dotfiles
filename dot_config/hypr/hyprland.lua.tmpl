-- Submaps
local power = 'System: (l) lock, (e) exit, (r) reboot, (s) suspend, (p) poweroff, (b) backup and shutdown, (Esc) cancel'
hl.bind(mod .. ' + CTRL + Q', dsp.submap(power))
hl.define_submap(power, 'reset', function()
  hl.bind('L', dsp.exec_cmd('dms ipc call lock lock'))
  hl.bind('E', dsp.exit())
  hl.bind('R', dsp.exec_cmd('reboot'))
  hl.bind('S', dsp.exec_cmd('systemctl suspend'))
  hl.bind('P', dsp.exec_cmd('poweroff'))
  hl.bind('B', dsp.exec_cmd('backintime backup & sleep 5s; backintime shutdown'))
  hl.bind('Escape', dsp.submap('reset'))
  hl.bind('catchall', dsp.submap('reset'))
end)

local resize = 'Resize: L: right / H: left / K: up / J: down / ESC: cancel'
local resize_prompt
local function clear_resize_prompt()
  if resize_prompt then
    resize_prompt:dismiss()
    resize_prompt = nil
  end
end
local function update_resize_prompt(submap)
  clear_resize_prompt()
  if submap == resize then
    resize_prompt = hl.notification.create({
      text = resize,
      timeout = 5000,
      icon = 'hint',
    })
    resize_prompt:pause()
  end
end
hl.on('keybinds.submap', update_resize_prompt)
hl.on('config.reloaded', function()
  update_resize_prompt(hl.get_current_submap())
end)
hl.on('config.unload', clear_resize_prompt)

hl.bind(mod .. ' + R', dsp.submap(resize))
hl.define_submap(resize, function()
  hl.bind('L', dsp.window.resize({ x = 10, y = 0, relative = true }), { repeating = true })
  hl.bind('H', dsp.window.resize({ x = -10, y = 0, relative = true }), { repeating = true })
  hl.bind('K', dsp.window.resize({ x = 0, y = -10, relative = true }), { repeating = true })
  hl.bind('J', dsp.window.resize({ x = 0, y = 10, relative = true }), { repeating = true })
  hl.bind('catchall', dsp.submap('reset'))
  hl.bind('Escape', dsp.submap('reset'))
end)

