{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "flexoki"
  },
  "keybinds": {
    "messages.copy": "none"
  },
  "plugins": [
    {
      "package": "./extensions/temp-export",
      "options": {
        "keybind": "<leader>y",
        "timestamps": true,
        "turnDuration": true,
        "thinking": false,
        "toolDetails": false,
        "assistantMetadata": true
      }
    },
    {
      "package": "file:///storage/projects/github.com/pbogut/opencode-pocket/master/packages/opencode-pocket-plugin/tui.js",
      "options": {
        "pocketUrls": [
          "http://127.0.0.1:8787",
          "http://127.0.0.1:8788"
        ]
      }
    },
    "./herdr-opencode"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "tabs": {
    "mode": "auto"
  }
}
