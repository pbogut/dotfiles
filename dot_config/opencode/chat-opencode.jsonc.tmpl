{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "chat",
  "mcp": {
    "linear": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"],
      "enabled": true
    },
    "personal-calendar": {
      "type": "remote",
      "url": "https://mcp.pbogut.me/calendar",
      "enabled": true
    },
    "gitlab": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote@0.14.2", "https://gitlab.com/api/v4/mcp"],
      "enabled": true,
      "timeout": 60000
    },
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "chat": {
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "variant": "medium",
      "description": "General chat agent with web access only",
      "permission": {
        "bash": "ask",
        "edit": "ask",
        "write": "ask",
        "read": "ask",
        "glob": "ask",
        "grep": "ask",
        "webfetch": "allow",
        "websearch": "allow"
      },
      "prompt": "You are a helpful general-purpose chat assistant. You have access to the web to fetch information. Do not attempt to modify files or execute shell commands."
    }
  },
  "provider": {{ include (joinPath .chezmoi.homeDir ".config/opencode/providers.json") }},
  "permission": {{ include (joinPath .chezmoi.homeDir ".config/opencode/permission.jsonc") }},
  "plugin": [
    ["@plannotator/opencode@latest", {
      "workflow": "user-managed",
    }],
    "@slkiser/opencode-quota@latest"
  ]
}
