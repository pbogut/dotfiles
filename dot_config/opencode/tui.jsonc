{
  "$schema": "https://opencode.ai/tui.json",
  "keybinds": {
    "messages_copy": "none"
  },
  "plugin": [
    [
      "./plugins/temp-export.ts",
      {
        "keybind": "<leader>y",
        "timestamps": true,
        "turnDuration": true,
        "thinking": false,
        "toolDetails": false,
        "assistantMetadata": true
      }
    ],
    [
      "file:///usr/lib/opencode-pocket/plugin/tui.js",
      {
        "pocketUrls": [
          "http://127.0.0.1:8787",
        ]
      }
    ],
    "./herdr-tui-session.js",
    "@slkiser/opencode-quota@latest"
  ]
}
