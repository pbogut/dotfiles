{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": { "model": "openai/gpt-6-astra" },
    "plan": { "model": "openai/gpt-6-astra" },
    "chat": {
      "mode": "primary",
      "hidden": true,
      "model": "openai/gpt-6.1-sol#medium",
      "description": "General chat assistant with web access",
      "system": "You are a helpful general-purpose chat assistant. You have access to the web to fetch information. Do not attempt to modify files or execute shell commands if you are not specifically asked for it.",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "read", "resource": "*", "effect": "ask" },
        { "action": "glob", "resource": "*", "effect": "ask" },
        { "action": "grep", "resource": "*", "effect": "ask" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "providers": {
    "copilot": {},
    "openai": {},
    "opencode-go": {},
    "ollama": {
      "settings": {{ (include "dot_config/opencode/providers.json" | fromJson).ollama.options | toJson }},
      "models": {{ (include "dot_config/opencode/providers.json" | fromJson).ollama.models | toJson }}
    }
  },
  // Keep the shared permission rules encrypted in chezmoi. V2 normalizes this
  // legacy field, including bash -> shell and task -> subagent.
  "permission": {{ include (joinPath .chezmoi.homeDir ".config/opencode/permission.jsonc") }},
  "permissions": [
    { "action": "switch_agent", "resource": "plan", "effect": "allow" },
    { "action": "switch_agent", "resource": "build", "effect": "ask" }
  ],
  "skills": ["{{ .chezmoi.homeDir }}/.config/opencode/skills"],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      },
      "linear": {
        "type": "local",
        "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"]
      },
      "gitlab": {
        "type": "local",
        "command": ["npx", "-y", "mcp-remote@0.14.2", "https://gitlab.com/api/v4/mcp"],
        "timeout": { "startup": 60000, "catalog": 60000, "execution": 60000 }
      },
      "browser-work": {
        "type": "local",
        "command": [
          "npx", "-y", "@playwright/mcp@latest",
          "--cdp-endpoint=http://127.0.0.1:9224",
          "--output-dir=/tmp/pbogut/opencode/playwright/work"
        ]
      },
      "browser-personal": {
        "type": "local",
        "command": [
          "npx", "-y", "@playwright/mcp@latest",
          "--cdp-endpoint=http://127.0.0.1:9223",
          "--output-dir=/tmp/pbogut/opencode/playwright/personal"
        ]
      },
      "chats-ferdium": {
        "type": "local",
        "command": [
          "npx", "-y", "@playwright/mcp@latest",
          "--cdp-endpoint=http://127.0.0.1:9225",
          "--output-dir=/tmp/pbogut/opencode/playwright/ferdium"
        ]
      }
    }
  },
  "plugins": [
    { "package": "@plannotator/opencode@latest", "options": { "workflow": "manual" } },
    "@slkiser/opencode-quota@latest",
    "{{ .chezmoi.homeDir }}/.local/share/opencode/plugins/lsp-builds/4a17bc8379e572ab104ec26b55f92ee9b51dce37-{{ include "assets/opencode2-lsp/sidebar.patch" | sha256sum }}"
  ],
  "lsp": {
    "php intelephense": {
      "command": ["intelephense", "--stdio"],
      "extensions": [".php"]
    },
    "typescript": { "command": ["typescript-language-server", "--stdio"] },
    "pyright": { "command": ["pyright-langserver", "--stdio"] },
    "bash": { "command": ["bash-language-server", "start"] },
    "lua": { "command": ["lua-language-server"], "extensions": [".lua"] },
    "gopls": { "command": ["gopls"] },
    "rust": { "command": ["rust-analyzer"] }
  }
}
