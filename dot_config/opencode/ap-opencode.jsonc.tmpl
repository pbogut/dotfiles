{
  "lsp": {},
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "gtm": {
      "type": "remote",
      "url": "https://gtm-mcp.stape.ai/mcp",
      "enabled": true
    },
    "linear": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"],
      "enabled": true
    },
    "gitlab": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote@0.14.2", "https://gitlab.com/api/v4/mcp"],
      "enabled": true,
      "timeout": 60000
    },
    "browser-work": {
      "type": "local",
      "command": [
        "npx", "-y", "@playwright/mcp@latest",
        "--cdp-endpoint=http://127.0.0.1:9224",
        "--output-dir=/tmp/pbogut/opencode/playwright/work"
      ],
      "enabled": true
    },
    "browser-personal": {
      "type": "local",
      "command": [
        "npx", "-y", "@playwright/mcp@latest",
        "--cdp-endpoint=http://127.0.0.1:9223",
        "--output-dir=/tmp/pbogut/opencode/playwright/personal"
      ],
      "enabled": true
    },
    "chats-ferdium": {
      "type": "local",
      "command": [
        "npx", "-y", "@playwright/mcp@latest",
        "--cdp-endpoint=http://127.0.0.1:9225",
        "--output-dir=/tmp/pbogut/opencode/playwright/ferdium"
      ],
      "enabled": true
    },
  },
  "agent": {
    "build": {
      "model": "openai/gpt-6-astra"
    },
    "plan": {
      "model": "openai/gpt-6-astra"
    }
  },
  "provider": {{ include (joinPath .chezmoi.homeDir ".config/opencode/providers.json") }},
  "permission": {{ include (joinPath .chezmoi.homeDir ".config/opencode/permission.jsonc") }},
  "plugin": [
    ["@plannotator/opencode@latest", {
      "workflow": "manual",
    }],
    "@slkiser/opencode-quota@latest"
  ]
}
