(defcfg
  input  (device-file "/dev/input/by-path/platform-i8042-serio-0-event-kbd")
  output (uinput-sink "My KMonad output"
    "/run/current-system/sw/bin/sleep 1 && /run/current-system/sw/bin/setxkbmap -option compose:ralt")

  fallthrough true
  allow-cmd false
)


(defalias
  kil  C-A-del                ;; Bind kil to a button that Ctrl-Alt-deletes
  kill M-S-q
  lp S-9
  rp S-0
  ces (tap-hold-next 250 esc (layer-toggle lctl))
  lsh (tap-hold-next 250 @lp lsft)
  rsh (tap-hold-next 250 @rp rsft)
  ctq (tap-hold-next 250 ' rctl)
  tab (tap-hold-next 250 tab (layer-toggle prog))
  bsl (tap-hold-next 250 \ (layer-toggle prog))
  ;; Press together for F15; hold either alone for normal repeat after 100 ms.
  j15 (tap-hold-next-press 100 j (layer-next j-held) :timeout-button j)
  k15 (tap-hold-next-press 100 k (layer-next k-held) :timeout-button k)
)


(defsrc
  esc        f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  ins prnt del
  grv        1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab        q    w    e    r    t    y    u    i    o    p    [    ]    ret
  caps       a    s    d    f    g    h    j    k    l    ;    '    \
  lsft  102d z    x    c    v    b    n    m    ,    .    /    rsft
  lctl  lmet lalt            spc                 ralt rctl left up down right
)


(deflayer main
  esc        f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  ins prnt del
  grv        1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tab       q    w    e    r    t    y    u    i    o    p    @bsl ]    ret
  @ces       a    s    d    f    g    h    @j15 @k15 l    ;    @ctq \
  @lsh  102d z    x    c    v    b    n    m    ,    .    /    @rsh
  lctl  lmet lalt            spc                ralt rctl left up down right
)


;; These layers handle one key, then return to the underlying layer.
;; Non-chord keys emit the pending letter before their normal action.
;; F15 stays down until the second key is released.
(deflayer j-held
  #(j esc)  #(j f1)   #(j f2)   #(j f3)   #(j f4)   #(j f5)   #(j f6)   #(j f7)   #(j f8)   #(j f9)   #(j f10)  #(j f11)  #(j f12)  #(j ins) #(j prnt) #(j del)
  #(j grv)  #(j 1)    #(j 2)    #(j 3)    #(j 4)    #(j 5)    #(j 6)    #(j 7)    #(j 8)    #(j 9)    #(j 0)    #(j -)    #(j =)    #(j bspc)
  #(j @tab) #(j q)    #(j w)    #(j e)    #(j r)    #(j t)    #(j y)    #(j u)    #(j i)    #(j o)    #(j p)    #(j @bsl) #(j ])    #(j ret)
  #(j @ces) #(j a)    #(j s)    #(j d)    #(j f)    #(j g)    #(j h)    #(j j)    f15       #(j l)    #(j ;)    #(j @ctq) #(j \\)
  #(j @lsh) #(j 102d) #(j z)    #(j x)    #(j c)    #(j v)    #(j b)    #(j n)    #(j m)    #(j ,)    #(j .)    #(j /)    #(j @rsh)
  #(j lctl) #(j lmet) #(j lalt)                     #(j spc)                      #(j ralt) #(j rctl) #(j left) #(j up)   #(j down) #(j right)
)

(deflayer k-held
  #(k esc)  #(k f1)   #(k f2)   #(k f3)   #(k f4)   #(k f5)   #(k f6)   #(k f7)   #(k f8)   #(k f9)   #(k f10)  #(k f11)  #(k f12)  #(k ins) #(k prnt) #(k del)
  #(k grv)  #(k 1)    #(k 2)    #(k 3)    #(k 4)    #(k 5)    #(k 6)    #(k 7)    #(k 8)    #(k 9)    #(k 0)    #(k -)    #(k =)    #(k bspc)
  #(k @tab) #(k q)    #(k w)    #(k e)    #(k r)    #(k t)    #(k y)    #(k u)    #(k i)    #(k o)    #(k p)    #(k @bsl) #(k ])    #(k ret)
  #(k @ces) #(k a)    #(k s)    #(k d)    #(k f)    #(k g)    #(k h)    f15       #(k k)    #(k l)    #(k ;)    #(k @ctq) #(k \\)
  #(k @lsh) #(k 102d) #(k z)    #(k x)    #(k c)    #(k v)    #(k b)    #(k n)    #(k m)    #(k ,)    #(k .)    #(k /)    #(k @rsh)
  #(k lctl) #(k lmet) #(k lalt)                     #(k spc)                      #(k ralt) #(k rctl) #(k left) #(k up)   #(k down) #(k right)
)

(deflayer prog
  esc        f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  ins prnt del
  grv        1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tab       !    *    $    -    S--  .    7    8    9    +    [    ]    ret
  @ces       &    #    ^    {    }    bspc 4    5    6    =    '    \
  @lsh  102d ~    %    @    [    ]    0    1    2    3    /    @rsh
  lctl  lmet lalt            spc                ralt rctl left up down right
)

;; its a bit of a hack, but it works, goal was to have ctlr+h behave as backspace
(deflayer lctl
  C-esc       C-f1 C-f2 C-f3 C-f4 C-f5 C-f6 C-f7 C-f8 C-f9 C-f10 C-f11 C-f12 C-ins C-prnt C-del
  C-grv       C-1  C-2  C-3  C-4  C-5  C-6  C-7  C-8  C-9  C-0   C--   C-=   C-bspc
  ~           C-q  C-w  C-e  C-r  C-t  C-y  C-u  C-i  C-o  C-p   C-[   C-]   C-ret
  @ces        C-a  C-s  C-d  C-f  C-g  bspc C-j  C-k  C-l  C-;   C-'   C-\
  C-@lsh 102d C-z  C-x  C-c  C-v  C-b  C-n  C-m  C-,  C-.  C-/   C-@rsh
  lctl C-lmet C-lalt            C-spc            C-ralt C-rctl C-left C-up C-down C-right
)
