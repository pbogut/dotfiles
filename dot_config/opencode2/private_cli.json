{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "flexoki"
  },
  "keybinds": {
    "messages.copy": "none"
  },
  "plugins": [
    {
      "package": "./extensions/temp-export",
      "options": {
        "keybind": "<leader>y",
        "timestamps": true,
        "turnDuration": true,
        "thinking": false,
        "toolDetails": false,
        "assistantMetadata": true
      }
    }
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "tabs": {
    "mode": "auto"
  }
}
