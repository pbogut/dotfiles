#!/usr/bin/env bash

plugin_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/runtime.sh
source "$plugin_root/lib/runtime.sh"

herdr=${HERDR_BIN_PATH:-herdr}

if [[ ${1:-} == --restore-all ]]; then
	snapshot=$("$herdr" api snapshot) || exit 1
	status=0
	while IFS=$'\t' read -r workspace_id role; do
		HERDR_ACTIVE_WORKSPACE_ID=$workspace_id bash "$0" "$role" --restore || status=1
	done < <(jq -r '
    def managed_role:
      if . == "nvim" then "nvim"
      elif . == "shell" then "shell"
      elif . == "shell-2" then "shell-2"
      elif . == "dev" then "dev"
      elif . == "sql" then "sql"
      elif . == "rest" then "rest"
      elif . == "git" then "git"
      elif . == "docker" then "docker"
      elif . == "opencode" then "opencode"
      elif . == "shell-3" then "shell-3"
      else null
      end;
    .result.snapshot.tabs[] |
    (.label | managed_role) as $role |
    select($role != null) |
    [.workspace_id, $role] |
    @tsv
  ' <<<"$snapshot")
	exit "$status"
fi

role=${1:?"tab role is required"}
shift
restore_only=false
focus_requested=true
while (($#)); do
	case $1 in
	--restore) restore_only=true ;;
	--no-focus) focus_requested=false ;;
	*)
		echo "Unsupported option: $1" >&2
		exit 1
		;;
	esac
	shift
done

declare -a command=()
case $role in
nvim | 1)
	role=nvim
	label=nvim
	legacy_slot=1
	command=(herdr-vim --start)
	;;
shell | 2)
	role=shell
	label=shell
	legacy_slot=2
	;;
shell-2 | 3)
	role=shell-2
	label=shell-2
	legacy_slot=3
	;;
dev | 4)
	role=dev
	label=dev
	legacy_slot=4
	command=(zsh -ic start-dev)
	;;
sql | 5)
	role=sql
	label=sql
	legacy_slot=5
	command=(zsh -ic 'draft sql')
	;;
rest | 6)
	role=rest
	label=rest
	legacy_slot=6
	command=(zsh -ic rest)
	;;
git | 7)
	role=git
	label=git
	legacy_slot=7
	command=(lazygit "--use-config-file=$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/config-herdr.yml")
	;;
docker | 8)
	role=docker
	label=docker
	legacy_slot=8
	command=(lazydocker)
	;;
opencode | 9)
	role=opencode
	label=opencode
	legacy_slot=9
	;;
shell-3 | 10)
	role=shell-3
	label=shell-3
	legacy_slot=10
	;;
*)
	echo "Unsupported tab role: $role" >&2
	exit 1
	;;
esac

workspace_id=${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}
[[ -n $workspace_id ]] || {
	echo "No active Herdr workspace" >&2
	exit 1
}
herdr_acquire_topology_lock "$workspace_id" || exit 1
role_cwd=${HERDR_ACTIVE_PANE_CWD:-$PWD}

focus_managed_tab() {
	if $focus_requested; then
		"$herdr" tab focus "$1" >/dev/null
	fi
}

move_tab() {
	local tab_id=$1 insert_index=$2 params

	params=$(jq -cn \
		--arg tab_id "$tab_id" \
		--argjson insert_index "$insert_index" \
		'{tab_id: $tab_id, insert_index: $insert_index}') || return 1
	herdr_api_request tab.move "$params" >/dev/null
}

sort_tabs() {
	local tabs=$1 index=0 tab_id

	while IFS= read -r tab_id; do
		move_tab "$tab_id" "$index" || return 1
		((index += 1))
	done < <(jq -r '
    def managed_rank:
      if . == "nvim" then 1
      elif . == "shell" then 2
      elif . == "shell-2" then 3
      elif . == "dev" then 4
      elif . == "sql" then 5
      elif . == "rest" then 6
      elif . == "git" then 7
      elif . == "docker" then 8
      elif . == "opencode" then 9
      elif . == "shell-3" then 10
      elif . == "setup" or . == "teardown" then 99
      else 999
      end;
    .result.tabs | sort_by(.label | managed_rank) | .[].tab_id
  ' <<<"$tabs")
}

pane_for_tab() {
	local tab_id=$1 panes

	panes=$("$herdr" pane list --workspace "$workspace_id") || return 1
	jq -c --arg tab_id "$tab_id" '
    [.result.panes[]? | select(.tab_id == $tab_id)][0] // empty
  ' <<<"$panes"
}

valid_session_id() {
	local session_id=$1

	[[ -n $session_id && ${#session_id} -le 256 && $session_id != *$'\n'* && $session_id != *$'\r'* ]]
}

native_opencode_session() {
	local pane=$1 session_id

	session_id=$(jq -er '
    .agent_session |
    select(.agent == "opencode" and .source == "herdr:opencode" and .kind == "id") |
    .value | select(type == "string")
  ' <<<"$pane" 2>/dev/null) || return 1
	valid_session_id "$session_id" || return 1
	printf '%s\n' "$session_id"
}

has_native_agent_session() {
	jq -e '
    .agent_session |
    .kind == "id" and (.value | type == "string" and length > 0)
  ' >/dev/null 2>&1 <<<"$1"
}

cache_opencode_session() {
	local session_id=$1

	valid_session_id "$session_id" || return 0
	"$herdr" workspace report-metadata "$workspace_id" \
		--source plugin:pbogut.project-layout \
		--token "opencode_session=$session_id" >/dev/null
}

set_opencode_command() {
	local session_id=${1:-} workspace

	if ! valid_session_id "$session_id"; then
		workspace=$("$herdr" workspace get "$workspace_id" 2>/dev/null) || workspace='{}'
		session_id=$(jq -r '.result.workspace.tokens.opencode_session // empty' <<<"$workspace")
	fi
	command=(opencode-launcher)
	if valid_session_id "$session_id"; then
		command+=(--session "$session_id")
	fi
	command+=(--port)
}

process_matches_role() {
	local pane_id=$1 process_info

	process_info=$("$herdr" pane process-info --pane "$pane_id" 2>/dev/null) || return 1
	jq -e --arg role "$role" '
    any(.result.process_info.foreground_processes[]?;
      if $role == "nvim" then
        .name == "nvim" or .name == "herdr-vim" or
        any(.argv[]?; test("(^|/)(nvim|herdr-vim)$"))
      elif $role == "opencode" then
        .name == "opencode" or
        any(.argv[]?; test("(^|/)(opencode|opencode-launcher)$"))
      elif $role == "dev" then
        any(.argv[]?; . == "start-dev")
      elif $role == "git" then
        .name == "lazygit" or any(.argv[]?; test("(^|/)lazygit$"))
      elif $role == "docker" then
        .name == "lazydocker" or any(.argv[]?; test("(^|/)lazydocker$"))
      else
        false
      end
    )
  ' >/dev/null 2>&1 <<<"$process_info"
}

apply_role() {
	local target_kind=$1 target_id=$2 root params command_json focus_json

	command_json=$(if ((${#command[@]})); then
		jq -cn --args '$ARGS.positional' -- "${command[@]}"
	else
		printf 'null\n'
	fi) || return 1
	root=$(jq -cn \
		--arg cwd "$role_cwd" \
		--argjson command "$command_json" '
      {type: "pane", cwd: $cwd} +
      if $command == null then {} else {command: $command} end
    ') || return 1
	$focus_requested && focus_json=true || focus_json=false
	params=$(jq -cn \
		--arg target_kind "$target_kind" \
		--arg target_id "$target_id" \
		--arg tab_label "$label" \
		--argjson focus "$focus_json" \
		--argjson root "$root" '
      {tab_label: $tab_label, focus: $focus, root: $root} +
      if $target_kind == "tab" then
        {tab_id: $target_id}
      else
        {workspace_id: $target_id}
      end
    ') || return 1
	herdr_api_request layout.apply "$params" >/dev/null
}

tabs=$("$herdr" tab list --workspace "$workspace_id") || exit 1
tab=$(jq -c \
	--arg label "$label" \
	--arg legacy_prefix "$legacy_slot:" '
  (
    [.result.tabs[] | select(.label == $label)][0] //
    [.result.tabs[] | select(.label | startswith($legacy_prefix))][0]
  ) // empty
' <<<"$tabs")
tab_id=$(jq -r '.tab_id // empty' <<<"$tab")
initial_tab_id=
if [[ -z $tab_id && $role == nvim ]] && ! $restore_only; then
	initial_tab_id=$(jq -r '
    [.result.tabs[] | select(.number == 1 and .label == "1")][0].tab_id // empty
  ' <<<"$tabs")
fi

if [[ -n $tab_id ]]; then
	if [[ $(jq -r '.label' <<<"$tab") != "$label" ]]; then
		"$herdr" tab rename "$tab_id" "$label" >/dev/null || exit 1
	fi
	pane=
	pane_id=
	if $restore_only || [[ $role == opencode ]]; then
		pane=$(pane_for_tab "$tab_id") || exit 1
		pane_id=$(jq -r '.pane_id // empty' <<<"$pane")
		pane_cwd=$(jq -r '.foreground_cwd // .cwd // empty' <<<"$pane")
		[[ ! -d $pane_cwd ]] || role_cwd=$pane_cwd
	fi

	if $restore_only; then
		if has_native_agent_session "$pane"; then
			exit 0
		fi
		case $role in
		shell | shell-2 | shell-3) exit 0 ;;
		sql | rest)
			"$herdr" tab close "$tab_id" >/dev/null
			exit
			;;
		opencode) set_opencode_command ;;
		esac
		if [[ -n $pane_id ]] && process_matches_role "$pane_id"; then
			exit 0
		fi
		apply_role tab "$tab_id" || exit 1
		tabs=$("$herdr" tab list --workspace "$workspace_id") || exit 1
		sort_tabs "$tabs" || echo "Could not reorder Herdr tabs" >&2
		exit
	fi

	case $role in
	nvim)
		focus_managed_tab "$tab_id"
		exit
		;;
	opencode)
		if [[ -n $pane_id ]] && process_matches_role "$pane_id"; then
			focus_managed_tab "$tab_id"
			exit
		fi
		session_id=$(native_opencode_session "$pane" 2>/dev/null) || session_id=
		[[ -z $session_id ]] || cache_opencode_session "$session_id"
		set_opencode_command "$session_id"
		;;
	*)
		focus_managed_tab "$tab_id"
		exit
		;;
	esac

	apply_role tab "$tab_id" || exit 1
else
	$restore_only && exit 0
	[[ $role != opencode ]] || set_opencode_command
	if [[ -n $initial_tab_id ]]; then
		apply_role tab "$initial_tab_id" || exit 1
	else
		apply_role workspace "$workspace_id" || exit 1
	fi
fi

tabs=$("$herdr" tab list --workspace "$workspace_id") || exit 1
sort_tabs "$tabs" || echo "Could not reorder Herdr tabs" >&2
