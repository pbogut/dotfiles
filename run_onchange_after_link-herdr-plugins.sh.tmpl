#!/usr/bin/env bash

set -euo pipefail

# Rerun when a plugin manifest changes.
# {{ include (joinPath .chezmoi.sourceDir "dot_config/herdr/plugins/project-layout/herdr-plugin.toml") | sha256sum }}
# {{ include (joinPath .chezmoi.sourceDir "dot_config/herdr/plugins/workspace-sort/herdr-plugin.toml") | sha256sum }}

if command -v herdr >/dev/null; then
	herdr plugin unlink pbogut.managed-tabs >/dev/null 2>&1 || true
	herdr plugin unlink pbogut.repo-metadata >/dev/null 2>&1 || true
	herdr plugin link "$HOME/.config/herdr/plugins/project-layout" --enabled
	herdr plugin link "$HOME/.config/herdr/plugins/workspace-sort" --enabled
fi
