diff --git a/test-status-view.js b/test-status-view.js
new file mode 100644
index 0000000..83769d1
--- /dev/null
+++ b/test-status-view.js
@@ -0,0 +1,55 @@
+import assert from "node:assert/strict"
+import { test } from "node:test"
+import { watchStatus } from "./src/status-view.ts"
+
+test("sidebar filters locations, rejects stale snapshots, recovers from errors and unsubscribes", async () => {
+  const location = { directory: "/project", workspaceID: "first" }
+  const views = []
+  const calls = []
+  let event
+  let disposed = false
+  const rpc = {
+    list(input, options) {
+      return new Promise((resolve, reject) => calls.push({ input, options, resolve, reject }))
+    },
+    events: {
+      on(name, callback) {
+        assert.equal(name, "changed")
+        event = callback
+        return () => { disposed = true }
+      },
+    },
+  }
+  const watch = watchStatus(rpc, location, (view) => views.push(view))
+  const tick = () => new Promise((resolve) => setImmediate(resolve))
+  assert.deepEqual(views.at(-1), { servers: [], loading: true, unavailable: false })
+  assert.deepEqual(calls[0].options.location, location)
+  event({ location: { directory: "/another-project", workspaceID: "first" } })
+  event({ location: { directory: "/project", workspaceID: "second" } })
+  assert.equal(calls.length, 1)
+  event({ location })
+  assert.equal(calls.length, 2)
+  assert.equal(calls[0].options.signal.aborted, true)
+  const servers = [{ id: "php intelephense", root: "/project", status: "running" }]
+  calls[1].resolve(servers)
+  await tick()
+  calls[0].resolve([])
+  await tick()
+  assert.deepEqual(views.at(-1), { servers, loading: false, unavailable: false })
+  const refresh = watch.refresh()
+  calls[2].reject(new Error("RPC unavailable during reload"))
+  await refresh
+  assert.equal(views.at(-1).unavailable, true)
+  event({ location })
+  calls[3].resolve([])
+  await tick()
+  assert.deepEqual(views.at(-1), { servers: [], loading: false, unavailable: false })
+  event({ location })
+  const count = views.length
+  watch.dispose()
+  calls[4].resolve(servers)
+  await tick()
+  assert.equal(calls[4].options.signal.aborted, true)
+  assert.equal(disposed, true)
+  assert.equal(views.length, count)
+})
