+function Sidebar(props: { context: Context; sessionID: string; collapsed: boolean; toggle: () => void }) {
+  const ctx = props.context
+  const [view, setView] = createSignal<StatusView>({ servers: [], loading: true, unavailable: false })
+  createEffect(() => {
+    const location = ctx.data.session.get(props.sessionID)?.location
+    if (!location) {
+      setView({ servers: [], loading: true, unavailable: false })
+      return
+    }
+    const status = watchStatus(ctx.client.rpc(LspStatus), location, setView)
+    const stop = ctx.data.on("plugin.updated", () => void status.refresh())
+    onCleanup(() => {
+      stop()
+      status.dispose()
+    })
+  })
+  return (
+    <box flexDirection="column" flexShrink={0}>
+      <box flexDirection="row" gap={1} onMouseUp={(event) => { if (event.button === 0) props.toggle() }}>
+        <text fg={ctx.theme.text.base}><b>{props.collapsed ? "▶" : "▼"} LSP</b></text>
+        <Show when={props.collapsed && !view().loading && !view().unavailable}>
+          <text fg={ctx.theme.text.muted}>({view().servers.filter((server) => server.status === "running").length} active)</text>
+        </Show>
+      </box>
+      <Show when={!props.collapsed}>
+        <Show when={!view().loading} fallback={<text fg={ctx.theme.text.muted}>Loading server status…</text>}>
+          <Show when={!view().unavailable} fallback={<text fg={ctx.theme.text.muted}>Server status unavailable</text>}>
+            <For each={view().servers} fallback={<text fg={ctx.theme.text.muted}>No active language servers</text>}>
+              {(server) => (
+                <box flexDirection="row" gap={1}>
+                  <text fg={server.status === "error" ? ctx.theme.text.feedback.error.base : server.status === "running" ? ctx.theme.text.feedback.success.base : ctx.theme.text.muted}>
+                    {server.status === "starting" ? "○" : "●"}
+                  </text>
+                  <text fg={ctx.theme.text.base}>
+                    {server.id}{server.status === "running" ? "" : ` (${server.status})`}
+                  </text>
+                </box>
+              )}
+            </For>
+          </Show>
+        </Show>
+      </Show>
+    </box>
+  )
+}
+
+export default {
+  id: "opencode-v2-lsp-support.tui",
+  setup(context: Context) {
+    const [sidebar, saveSidebar] = context.storage.store("sidebar", { initial: { collapsed: false } })
+    const toggle = () => void saveSidebar((draft) => { draft.collapsed = !draft.collapsed })
+      .catch((error) => console.error("Could not save LSP sidebar preference", error))
+    return context.ui.slot({
+      append: "sidebar.content",
+      render: (props) => <Sidebar context={context} sessionID={props.sessionID} collapsed={sidebar.collapsed} toggle={toggle} />,
+    })
+  },
+}
