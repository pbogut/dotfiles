new file mode 100644
index 0000000..51e3ac7
--- /dev/null
+++ b/src/status-view.ts
@@ -0,0 +1,49 @@
+import type { ServerStatus } from "./status.ts"
+
+export interface Location {
+  readonly directory: string
+  readonly workspaceID?: string
+}
+
+export interface StatusView {
+  readonly servers: ServerStatus[]
+  readonly loading: boolean
+  readonly unavailable: boolean
+}
+
+interface StatusClient {
+  list(input: object, options: { location: Location; signal: AbortSignal }): Promise<unknown>
+  events: { on(name: "changed", callback: (event: { location: Location }) => void): () => void }
+}
+
+// Subscribe before fetching. Abort obsolete requests so a slow response cannot
+// restore stale state after a newer event, session switch, or component disposal.
+export function watchStatus(rpc: StatusClient, location: Location, update: (view: StatusView) => void) {
+  let closed = false
+  let request: AbortController | undefined
+  update({ servers: [], loading: true, unavailable: false })
+  const refresh = async () => {
+    request?.abort()
+    const current = new AbortController()
+    request = current
+    try {
+      const servers = await rpc.list({}, { location, signal: current.signal }) as ServerStatus[]
+      if (!closed && request === current) update({ servers, loading: false, unavailable: false })
+    } catch {
+      if (!closed && request === current) update({ servers: [], loading: false, unavailable: true })
+    }
+  }
+  const unsubscribe = rpc.events.on("changed", (event) => {
+    if (event.location.directory !== location.directory || event.location.workspaceID !== location.workspaceID) return
+    void refresh()
+  })
+  void refresh()
+  return {
+    refresh,
+    dispose() {
+      closed = true
+      request?.abort()
+      unsubscribe()
+    },
+  }
+}
