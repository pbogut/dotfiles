#!/usr/bin/env bash

set -o pipefail

plugin_id="pbogut.project-layout"
layout_name=".herdr-layout.sh"
herdr=${HERDR_BIN_PATH:-herdr}
workspace_id=${HERDR_LAYOUT_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}
worktree_dir=""
project_dir=""
layout_file=""
setup_deferred_status=75
setup_resume_status=76
setup_failed_status=77
setup_ready_status=78

notify() {
	"$herdr" notification show "$1" --body "$2" >/dev/null 2>&1 || true
}

print_confirmation_buttons() {
	local confirm_label=${1:-confirm}
	local cancel_label=${2:-cancel}
	local variant=${3:-danger}
	local confirm_text=" ↵ $confirm_label "
	local cancel_text=" esc $cancel_label "
	local columns padding primary_rgb

	case $variant in
	accent) primary_rgb='122;162;247' ;;
	*) primary_rgb='247;118;142' ;;
	esac

	# Match Herdr's Tokyo Night primary and secondary action buttons.
	if columns=$(tput cols 2>/dev/null) && [[ $columns =~ ^[0-9]+$ ]]; then
		padding=$(((columns - ${#confirm_text} - ${#cancel_text} - 2) / 2))
		((padding > 0)) && printf '%*s' "$padding" ''
	fi
	printf '\033[1;38;2;26;27;38;48;2;%sm%s\033[0m  ' "$primary_rgb" "$confirm_text"
	printf '\033[1;38;2;192;202;245;48;2;36;40;59m%s\033[0m\n' "$cancel_text"
}

print_action_button() {
	local label=${1:-done}
	local text=" ↵ $label "
	local columns padding

	if columns=$(tput cols 2>/dev/null) && [[ $columns =~ ^[0-9]+$ ]]; then
		padding=$(((columns - ${#text}) / 2))
		((padding > 0)) && printf '%*s' "$padding" ''
	fi
	printf '\033[1;38;2;26;27;38;48;2;122;162;247m%s\033[0m\n' "$text"
}

confirm_with_enter() {
	local choice

	while IFS= read -r -s -n 1 choice; do
		case $choice in
		"")
			return 0
			;;
		$'\e')
			return 1
			;;
		esac
	done

	return 1
}

wait_for_enter() {
	local choice

	while IFS= read -r -s -n 1 choice; do
		if [[ -z $choice ]]; then
			return 0
		fi
	done

	return 1
}

wait_for_setup_autoclose() {
	local seconds choice

	for seconds in 5 4 3 2 1; do
		printf '\r\033[K'
		print_confirmation_buttons "close in ${seconds}s" "keep open" accent
		printf '\033[1A'
		choice=
		if IFS= read -r -s -n 1 -t 1 choice; then
			case $choice in
			"")
				printf '\r\033[K'
				return 0
				;;
			$'\e')
				printf '\r\033[KAuto-close cancelled.\n\n'
				print_action_button close
				wait_for_enter
				return
				;;
			esac
		fi
	done
	# printf '\r\033[K'
	return 0
}

resolve_context() {
	local candidate=${1:-${HERDR_LAYOUT_WORKTREE:-}}
	local event context common_dir panes

	event=${HERDR_PLUGIN_EVENT_JSON:-'{}'}
	context=${HERDR_PLUGIN_CONTEXT_JSON:-'{}'}
	if [[ -z $workspace_id ]]; then
		workspace_id=$(jq -r '.data.workspace.workspace_id // empty' <<<"$event" 2>/dev/null)
	fi
	if [[ -z $workspace_id ]]; then
		workspace_id=$(jq -r '.workspace_id // empty' <<<"$context" 2>/dev/null)
	fi

	if [[ -z $candidate ]]; then
		candidate=$(jq -r '.data.worktree.path // empty' <<<"$event" 2>/dev/null)
	fi
	if [[ -z $candidate ]]; then
		candidate=$(jq -r '
      .worktree.checkout_path //
      .focused_pane_cwd //
      .workspace_cwd //
      empty
    ' <<<"$context" 2>/dev/null)
	fi
	if [[ -z $candidate && -n $workspace_id ]]; then
		panes=$("$herdr" pane list --workspace "$workspace_id" 2>/dev/null) || panes='{}'
		candidate=$(jq -r '
      ([.result.panes[]? | select(.focused) | (.foreground_cwd // .cwd)][0] //
       [.result.panes[]? | (.foreground_cwd // .cwd)][0] //
       empty)
    ' <<<"$panes" 2>/dev/null)
	fi
	[[ -n $candidate ]] || candidate=$PWD
	[[ -d $candidate ]] || return 1

	worktree_dir=$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null) || return 1
	worktree_dir=$(realpath -e -- "$worktree_dir") || return 1
	common_dir=$(git -C "$worktree_dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
	common_dir=$(realpath -e -- "$common_dir") || return 1
	[[ ${common_dir##*/} == .bare ]] || return 1

	project_dir=$(realpath -e -- "${common_dir%/*}") || return 1
	[[ $worktree_dir == "$project_dir/"* ]] || return 1
	layout_file="$project_dir/$layout_name"
}

refresh_workspace_id() {
	local snapshot resolved

	for _ in {1..50}; do
		snapshot=$("$herdr" api snapshot 2>/dev/null) || {
			sleep 0.1
			continue
		}
		resolved=$(jq -r --arg path "$worktree_dir" '
      [.result.snapshot.panes[] |
        select(.cwd == $path or .foreground_cwd == $path) |
        .workspace_id][0] // empty
    ' <<<"$snapshot")
		if [[ -n $resolved ]]; then
			workspace_id=$resolved
			return 0
		fi
		sleep 0.1
	done

	echo "No Herdr workspace found for $worktree_dir" >&2
	return 1
}

is_layout_file() {
	[[ -f $layout_file && ! -L $layout_file ]]
}

write_layout_template() {
	# shellcheck disable=SC2016 # Template variables must remain literal.
	printf '%s\n' \
		'# Tabs to create whenever this worktree is opened through herdr-project.' \
		'HERDR_TABS=(nvim dev opencode)' \
		'' \
		'# Use a Bash array. This command runs from the worktree root.' \
		'HERDR_DEV_COMMAND=(make dev)' \
		'' \
		'# Increment this value when setup needs to run again.' \
		'HERDR_SETUP_VERSION=1' \
		'' \
		'# Setup runs once per worktree and setup version. Keep it idempotent.' \
		'herdr_setup() {' \
		'  # Example:' \
		'  # [[ -e "$HERDR_WORKTREE_DIR/.env" ]] ||' \
		'  #   install -m 600 "$HERDR_PROJECT_DIR/shared/.env" "$HERDR_WORKTREE_DIR/.env"' \
		'  :' \
		'}' \
		'' \
		'# Teardown runs before the safe-close shortcut closes the workspace.' \
		'# Return nonzero when cleanup is unsafe or incomplete; Herdr will ask whether to close anyway.' \
		'herdr_teardown() {' \
		'  # Example:' \
		'  # git-wt-cleanup --check "$HERDR_WORKTREE_DIR" || return' \
		'  # docker compose down || return' \
		'  # git-wt-cleanup --safe-only "$HERDR_WORKTREE_DIR"' \
		'  :' \
		'}'
}

init_layout() {
	local editor

	resolve_context || {
		echo "Run this command from a worktree whose common Git directory is .bare" >&2
		return 1
	}
	if [[ -e $layout_file || -L $layout_file ]]; then
		is_layout_file || {
			echo "Project layout is not a regular file: $layout_file" >&2
			return 1
		}
	else
		umask 077
		if ! (set -o noclobber; write_layout_template >"$layout_file"); then
			echo "Could not create project layout: $layout_file" >&2
			return 1
		fi
		chmod 600 "$layout_file" || return 1
		notify "Project layout created" "$layout_file"
	fi

	if [[ -n $workspace_id ]] && refresh_workspace_id; then
		HERDR_ACTIVE_WORKSPACE_ID=$workspace_id \
			HERDR_ACTIVE_PANE_CWD=$worktree_dir \
			herdr-vim -- "$layout_file"
		return
	fi

	editor=${VISUAL:-${EDITOR:-nvim}}
	"$editor" "$layout_file"
}

get_config_dir() {
	if [[ -n ${HERDR_PLUGIN_CONFIG_DIR:-} ]]; then
		printf '%s\n' "$HERDR_PLUGIN_CONFIG_DIR"
		return
	fi
	"$herdr" plugin config-dir "$plugin_id" 2>/dev/null
}

is_trusted() {
	local config_dir trust_file

	config_dir=$(get_config_dir) || return 1
	trust_file="$config_dir/trusted-projects.json"
	[[ -f $trust_file ]] || return 1
	jq -e --arg project "$project_dir" '
    type == "array" and index($project) != null
  ' "$trust_file" >/dev/null 2>&1
}

update_trust() {
	local operation=$1
	local config_dir trust_file trust_json updated tmp
	local lock_fd

	config_dir=$(get_config_dir) || {
		echo "Could not locate the project-layout config directory" >&2
		return 1
	}
	mkdir -p -- "$config_dir" || return 1
	trust_file="$config_dir/trusted-projects.json"
	umask 077
	if ! exec {lock_fd}>"$trust_file.lock"; then
		echo "Could not open trust registry lock" >&2
		return 1
	fi
	if ! flock "$lock_fd"; then
		echo "Could not lock the trust registry" >&2
		exec {lock_fd}>&-
		return 1
	fi

	if [[ -f $trust_file ]]; then
		trust_json=$(<"$trust_file")
		if ! jq -e 'type == "array" and all(.[]; type == "string")' >/dev/null 2>&1 <<<"$trust_json"; then
			echo "Invalid trust registry: $trust_file" >&2
			exec {lock_fd}>&-
			return 1
		fi
	else
		trust_json='[]'
	fi

	case $operation in
	add)
		updated=$(jq -c --arg project "$project_dir" '
      if index($project) == null then . + [$project] else . end
    ' <<<"$trust_json") || {
			exec {lock_fd}>&-
			return 1
		}
		;;
	remove)
		updated=$(jq -c --arg project "$project_dir" 'map(select(. != $project))' <<<"$trust_json") || {
			exec {lock_fd}>&-
			return 1
		}
		;;
	*)
		exec {lock_fd}>&-
		return 1
		;;
	esac

	tmp=$(mktemp "$config_dir/.trusted-projects.XXXXXX") || {
		exec {lock_fd}>&-
		return 1
	}
	if ! printf '%s\n' "$updated" >"$tmp" ||
		! chmod 600 "$tmp" ||
		! mv -f -- "$tmp" "$trust_file"; then
		rm -f -- "$tmp"
		exec {lock_fd}>&-
		return 1
	fi
	exec {lock_fd}>&- || true
	return 0
}

load_layout() {
	HERDR_TABS=(nvim dev opencode)
	HERDR_DEV_COMMAND=(make dev)
	HERDR_SETUP_VERSION=1
	unset -f herdr_setup 2>/dev/null || true
	unset -f herdr_teardown 2>/dev/null || true
	export HERDR_PROJECT_DIR=$project_dir
	export HERDR_WORKTREE_DIR=$worktree_dir
	export HERDR_LAYOUT_FILE=$layout_file

	# shellcheck source=/dev/null
	source "$layout_file" || return 1
	if [[ $(declare -p HERDR_TABS 2>/dev/null) != "declare -a"* ]]; then
		echo "HERDR_TABS must be a Bash array in $layout_file" >&2
		return 1
	fi
	if [[ $(declare -p HERDR_DEV_COMMAND 2>/dev/null) != "declare -a"* ]]; then
		echo "HERDR_DEV_COMMAND must be a Bash array in $layout_file" >&2
		return 1
	fi
	if [[ ! $HERDR_SETUP_VERSION =~ ^[A-Za-z0-9._-]{1,80}$ ]]; then
		echo "HERDR_SETUP_VERSION is invalid in $layout_file" >&2
		return 1
	fi
}

finish_setup() {
	if [[ ${HERDR_PLUGIN_ENTRYPOINT_ID:-} == trust ]]; then
		if "$herdr" plugin action invoke apply --plugin "$plugin_id" >/dev/null 2>&1; then
			return "$setup_resume_status"
		fi
		notify "Project layout handoff failed" "Opening tabs in the current popup"
	fi
	return 0
}

run_setup() {
	local config_dir setup_dir worktree_identity marker_key marker tmp lock_fd
	local setup_status

	if ! declare -F herdr_setup >/dev/null; then
		finish_setup
		return
	fi
	config_dir=$(get_config_dir) || return 1
	setup_dir="$config_dir/setup"
	mkdir -p -- "$setup_dir" || return 1
	worktree_identity=$(stat -c '%d:%i:%W' "$worktree_dir/.git") || return 1
	read -r marker_key _ < <(
		printf '%s\0%s\0%s\0' "$worktree_dir" "$worktree_identity" "$HERDR_SETUP_VERSION" | sha256sum
	)
	marker="$setup_dir/$marker_key"
	if ! exec {lock_fd}>"$marker.lock"; then
		echo "Could not open the project setup lock" >&2
		return 1
	fi
	if ! flock "$lock_fd"; then
		echo "Could not lock project setup" >&2
		exec {lock_fd}>&-
		return 1
	fi
	if [[ -f $marker ]]; then
		exec {lock_fd}>&- || true
		finish_setup
		return
	fi

	if [[ ${HERDR_PLUGIN_ENTRYPOINT_ID:-} != setup ]]; then
		exec {lock_fd}>&-
		request_setup_tab || return 1
		return "$setup_deferred_status"
	fi

	[[ ! -t 1 ]] || printf '\033[2J\033[H'
	printf 'Setting up...\n\n'
	if (cd "$worktree_dir" && herdr_setup); then
		setup_status=0
	else
		setup_status=$?
	fi

	if ((setup_status != 0)); then
		printf '\nSetup failed (exit %d).\n\n' "$setup_status"
		notify "Project setup failed" "$worktree_dir"
		exec {lock_fd}>&- || true
		return "$setup_failed_status"
	fi

	umask 077
	tmp=$(mktemp "$setup_dir/.setup.XXXXXX") || {
		exec {lock_fd}>&-
		return 1
	}
	if ! printf 'project=%s\nworktree=%s\nversion=%s\n' \
		"$project_dir" "$worktree_dir" "$HERDR_SETUP_VERSION" >"$tmp" ||
		! mv -f -- "$tmp" "$marker"; then
		rm -f -- "$tmp"
		echo "Could not record project setup for $worktree_dir" >&2
		notify "Project setup state was not saved" "$worktree_dir"
		exec {lock_fd}>&-
		return 1
	fi
	exec {lock_fd}>&- || true
	finish_setup
}

select_managed_tab() {
	local role=$1
	local status=1
	shift

	for _ in {1..3}; do
		refresh_workspace_id || return 1
		HERDR_ACTIVE_WORKSPACE_ID=$workspace_id \
			HERDR_ACTIVE_PANE_CWD=$worktree_dir \
			herdr-select-tab-or-new "$role" "$@"
		status=$?
		((status == 0)) && return 0
		sleep 0.1
	done

	return "$status"
}

ensure_editor() {
	select_managed_tab nvim
	select_managed_tab nvim --ensure-running
}

close_plugin_tab() {
	[[ -n ${HERDR_TAB_ID:-} ]] || return 1
	"$herdr" tab close "$HERDR_TAB_ID" >/dev/null
}

close_sibling_tabs() {
	local tabs tab_ids tab_id

	[[ -n ${HERDR_TAB_ID:-} ]] || {
		echo "No teardown tab is available" >&2
		return 1
	}
	tabs=$("$herdr" tab list --workspace "$workspace_id" 2>/dev/null) || {
		echo "Could not list tabs for workspace $workspace_id" >&2
		return 1
	}
	if ! jq -e --arg current "$HERDR_TAB_ID" '
      .result.tabs | type == "array" and any(.[]; .tab_id == $current)
    ' >/dev/null 2>&1 <<<"$tabs"; then
		echo "Teardown tab $HERDR_TAB_ID was not found in workspace $workspace_id" >&2
		return 1
	fi
	tab_ids=$(jq -r --arg current "$HERDR_TAB_ID" '
      .result.tabs[] | select(.tab_id != $current) | .tab_id
    ' <<<"$tabs") || return 1

	while IFS= read -r tab_id; do
		[[ -n $tab_id ]] || continue
		if ! "$herdr" tab close "$tab_id" >/dev/null; then
			echo "Could not close tab $tab_id" >&2
			return 1
		fi
	done <<<"$tab_ids"
}

finish_setup_tab() {
	local outcome=$1

	if [[ $outcome == failed ]]; then
		print_action_button "open nvim"
		wait_for_enter || return 1
	else
		printf '\nDone.\n\n'
		wait_for_setup_autoclose || return 0
	fi
	ensure_editor || true
	if ! close_plugin_tab; then
		notify "Project setup tab remained open" "Close it manually"
		return 1
	fi
}

apply_layout_unlocked() {
	local role setup_status status=0
	local -A seen=()

	refresh_workspace_id || return 1
	load_layout || {
		notify "Invalid project layout" "$layout_file"
		return 1
	}
	run_setup
	setup_status=$?
	if ((setup_status == setup_resume_status)); then
		return "$setup_resume_status"
	elif ((setup_status == setup_deferred_status)); then
		return 0
	elif ((setup_status == setup_failed_status)); then
		return "$setup_failed_status"
	elif ((setup_status != 0)); then
		if [[ ${HERDR_PLUGIN_ENTRYPOINT_ID:-} == setup ]]; then
			return "$setup_failed_status"
		fi
		ensure_editor || true
		return 1
	fi
	[[ -n $workspace_id ]] || {
		echo "No Herdr workspace is available for $worktree_dir" >&2
		return 1
	}

	for role in "${HERDR_TABS[@]}"; do
		case $role in
		nvim | shell | shell-2 | dev | sql | rest | git | docker | opencode | shell-3) ;;
		*)
			echo "Unsupported project layout tab: $role" >&2
			status=1
			continue
			;;
		esac
		[[ -z ${seen[$role]:-} ]] || continue
		seen[$role]=1
		if [[ $role == nvim ]]; then
			select_managed_tab "$role" --ensure-running --no-focus || status=1
		else
			select_managed_tab "$role" --no-focus || status=1
		fi
	done

	if [[ ${HERDR_PLUGIN_ENTRYPOINT_ID:-} != setup ]]; then
		ensure_editor || status=1
	fi
	if ((status != 0)); then
		notify "Project layout incomplete" "$worktree_dir"
	fi
	if [[ ${HERDR_PLUGIN_ENTRYPOINT_ID:-} == setup ]]; then
		return "$setup_ready_status"
	fi
	return "$status"
}

apply_layout() {
	local config_dir lock_dir lock_key status lock_fd

	config_dir=$(get_config_dir) || return 1
	lock_dir="$config_dir/apply-locks"
	mkdir -p -- "$lock_dir" || return 1
	read -r lock_key _ < <(printf '%s\0' "$worktree_dir" | sha256sum)
	if ! exec {lock_fd}>"$lock_dir/$lock_key.lock"; then
		echo "Could not open the project layout lock" >&2
		return 1
	fi
	if ! flock "$lock_fd"; then
		echo "Could not lock the project layout" >&2
		exec {lock_fd}>&-
		return 1
	fi

	apply_layout_unlocked
	status=$?
	if ((status == setup_resume_status)); then
		# Keep the lock until process exit so the background action starts after the popup closes.
		exit 0
	fi
	exec {lock_fd}>&- || true
	if ((status == setup_ready_status)); then
		finish_setup_tab ready
		return
	elif ((status == setup_failed_status)) ||
		[[ ${HERDR_PLUGIN_ENTRYPOINT_ID:-} == setup && $status != 0 ]]; then
		finish_setup_tab failed
		return 1
	fi
	return "$status"
}

request_prompt() {
	local response focused_workspace

	for _ in {1..30}; do
		focused_workspace=$("$herdr" api snapshot 2>/dev/null |
			jq -r '.result.snapshot.focused_workspace_id // empty')
		if [[ $focused_workspace != "$workspace_id" ]]; then
			notify "Project layout needs trust" "Focus $worktree_dir and use the Trust and apply project layout action"
			return 1
		fi

		response=$("$herdr" plugin pane open \
			--plugin "$plugin_id" \
			--entrypoint trust \
			--cwd "$worktree_dir" \
			--env "HERDR_LAYOUT_WORKTREE=$worktree_dir" \
			--env "HERDR_LAYOUT_WORKSPACE_ID=$workspace_id" \
			--focus 2>&1) && return 0
		[[ $response == *ui_busy* ]] || break
		sleep 0.1
	done

	echo "$response" >&2
	notify "Project layout needs trust" "Use the Trust and apply project layout action for $project_dir"
	return 1
}

rename_opened_plugin_tab() {
	local response=$1
	local label=$2
	local tab_id

	tab_id=$(jq -r '.result.plugin_pane.pane.tab_id // empty' <<<"$response") || return 1
	[[ -n $tab_id ]] || return 1
	"$herdr" tab rename "$tab_id" "$label" >/dev/null
}

request_setup_tab() {
	local response focused_workspace

	for _ in {1..30}; do
		focused_workspace=$("$herdr" api snapshot 2>/dev/null |
			jq -r '.result.snapshot.focused_workspace_id // empty')
		if [[ $focused_workspace != "$workspace_id" ]]; then
			notify "Project setup pending" "Focus $worktree_dir and apply its project layout"
			return 1
		fi

		if response=$("$herdr" plugin pane open \
			--plugin "$plugin_id" \
			--entrypoint setup \
			--placement tab \
			--workspace "$workspace_id" \
			--cwd "$worktree_dir" \
			--env "HERDR_LAYOUT_WORKTREE=$worktree_dir" \
			--env "HERDR_LAYOUT_WORKSPACE_ID=$workspace_id" \
			--focus 2>&1); then
			rename_opened_plugin_tab "$response" setup ||
				notify "Project setup tab was not named" "Rename it to setup manually"
			return 0
		fi
		[[ $response == *ui_busy* ]] || break
		sleep 0.1
	done

	echo "$response" >&2
	notify "Project setup pending" "Could not open the setup tab for $worktree_dir"
	return 1
}

request_teardown_confirmation() {
	local candidate context focused_workspace panes response

	context=${HERDR_PLUGIN_CONTEXT_JSON:-'{}'}
	if [[ -z $workspace_id ]]; then
		workspace_id=$(jq -r '.workspace_id // empty' <<<"$context" 2>/dev/null)
	fi
	[[ -n $workspace_id ]] || {
		echo "No Herdr workspace is available" >&2
		return 1
	}

	candidate=${HERDR_LAYOUT_WORKTREE:-}
	if [[ -z $candidate ]]; then
		candidate=$(jq -r '
      .worktree.checkout_path //
      .focused_pane_cwd //
      .workspace_cwd //
      empty
    ' <<<"$context" 2>/dev/null)
	fi
	if [[ -z $candidate ]]; then
		panes=$("$herdr" pane list --workspace "$workspace_id" 2>/dev/null) || panes='{}'
		candidate=$(jq -r '
      ([.result.panes[]? | select(.focused) | (.foreground_cwd // .cwd)][0] //
       [.result.panes[]? | (.foreground_cwd // .cwd)][0] //
       empty)
    ' <<<"$panes" 2>/dev/null)
	fi
	[[ -d $candidate ]] || candidate=$PWD
	[[ -d $candidate ]] || candidate=$HOME

	for _ in {1..30}; do
		focused_workspace=$("$herdr" api snapshot 2>/dev/null |
			jq -r '.result.snapshot.focused_workspace_id // empty')
		if [[ $focused_workspace != "$workspace_id" ]]; then
			notify "Workspace was not closed" "Focus it and run the close shortcut again"
			return 1
		fi

		response=$("$herdr" plugin pane open \
			--plugin "$plugin_id" \
			--entrypoint teardown-confirm \
			--cwd "$candidate" \
			--env "HERDR_LAYOUT_WORKTREE=$candidate" \
			--env "HERDR_LAYOUT_WORKSPACE_ID=$workspace_id" \
			--focus 2>&1) && return 0
		[[ $response == *ui_busy* ]] || break
		sleep 0.1
	done

	echo "$response" >&2
	notify "Workspace was not closed" "Could not open the teardown popup"
	return 1
}

request_teardown_tab() {
	local candidate=$1
	local response

	if response=$("$herdr" plugin pane open \
		--plugin "$plugin_id" \
		--entrypoint teardown \
		--placement tab \
		--workspace "$workspace_id" \
		--cwd "$candidate" \
		--env "HERDR_LAYOUT_WORKTREE=$candidate" \
		--env "HERDR_LAYOUT_WORKSPACE_ID=$workspace_id" \
		--focus 2>&1); then
		rename_opened_plugin_tab "$response" teardown ||
			notify "Project teardown tab was not named" "Rename it to teardown manually"
		return 0
	fi

	echo "$response" >&2
	notify "Workspace was not closed" "Could not open the teardown tab"
	return 1
}

confirm_workspace_close() {
	local candidate

	[[ -n $workspace_id ]] || {
		echo "No Herdr workspace is available" >&2
		return 1
	}
	candidate=${HERDR_LAYOUT_WORKTREE:-$PWD}

	printf '\n\033[1;38;2;247;118;142mClose workspace?\033[0m\n\n'
	printf 'Workspace: %s\n' "$workspace_id"
	printf 'Directory: %s\n\n' "$candidate"
	print_confirmation_buttons
	if ! confirm_with_enter; then
		printf 'Cancelled.\n'
		return 0
	fi

	request_teardown_tab "$candidate"
}

close_workspace_with_teardown() {
	local candidate teardown_status=0
	local teardown_configured=false

	[[ -n $workspace_id ]] || {
		echo "No Herdr workspace is available" >&2
		return 1
	}
	candidate=${HERDR_LAYOUT_WORKTREE:-$PWD}

	if resolve_context "$candidate" && is_layout_file && is_trusted; then
		teardown_configured=true
		if ! load_layout; then
			teardown_status=1
		elif declare -F herdr_teardown >/dev/null; then
			printf '\nTearing down...\n\n'
			if ! close_sibling_tabs; then
				teardown_status=1
			elif (cd "$worktree_dir" && herdr_teardown); then
				teardown_status=0
			else
				teardown_status=$?
			fi
		else
			teardown_configured=false
		fi
	fi

	if $teardown_configured; then
		if ((teardown_status == 0)); then
			printf '\nDone.\n'
			notify "Project teardown complete" "$candidate"
		else
			printf '\nTeardown did not complete (exit %d).\n' "$teardown_status"
			printf 'Project resources may remain.\n\n'
			notify "Project teardown failed" "$candidate"
			print_confirmation_buttons "close anyway" "keep open"
			if ! confirm_with_enter; then
				printf 'Workspace kept open.\n'
				ensure_editor || true
				if ! close_plugin_tab; then
					notify "Project teardown tab remained open" "Close it manually"
				fi
				return 0
			fi
		fi
	else
		printf '\nNo trusted project teardown is configured.\n'
	fi

	if ! "$herdr" workspace close "$workspace_id" >/dev/null; then
		notify "Workspace close failed" "$workspace_id"
		return 1
	fi
}

trust_project() {
	is_layout_file || {
		echo "No regular $layout_name file at $project_dir" >&2
		return 1
	}
	update_trust add || return 1
	notify "Project layout trusted" "$project_dir"
	apply_layout
}

prompt_for_trust() {
	resolve_context || exit 1
	is_layout_file || exit 0
	if is_trusted; then
		apply_layout
		exit
	fi

	printf '\nTrust project layout?\n\n'
	printf 'Project: %s\n' "$project_dir"
	printf 'Config:  %s\n\n' "$layout_file"
	printf 'This file may copy files and execute commands in every worktree.\n\n'
	print_confirmation_buttons "trust and apply" "not now" accent
	if confirm_with_enter; then
		trust_project
	else
		printf 'Project layout was not trusted.\n'
		ensure_editor
	fi
}

handle_event() {
	resolve_context || exit 0
	if ! is_layout_file; then
		ensure_editor
		exit
	fi
	if is_trusted; then
		apply_layout
	else
		request_prompt || ensure_editor
	fi
}

run_dev() {
	local dev_dir=$PWD

	if resolve_context; then
		dev_dir=$worktree_dir
		if is_layout_file && is_trusted; then
			load_layout || return 1
			((${#HERDR_DEV_COMMAND[@]} > 0)) || return 0
			(cd "$worktree_dir" && "${HERDR_DEV_COMMAND[@]}")
			return
		fi
	fi

	if [[ -f $dev_dir/Makefile ]]; then
		(cd "$dev_dir" && make dev)
	fi
}

case ${1:-} in
init)
	init_layout
	;;
event)
	handle_event
	;;
prompt)
	prompt_for_trust
	;;
setup)
	resolve_context || exit 1
	is_layout_file && is_trusted || exit 1
	apply_layout
	;;
close)
	request_teardown_confirmation
	;;
confirm-close)
	confirm_workspace_close
	;;
teardown)
	close_workspace_with_teardown
	;;
apply)
	resolve_context || exit 1
	is_layout_file || {
		ensure_editor
		exit
	}
	if is_trusted; then
		apply_layout
	else
		request_prompt || ensure_editor
	fi
	;;
trust)
	resolve_context || exit 1
	trust_project
	;;
revoke)
	resolve_context || exit 1
	update_trust remove || exit 1
	notify "Project layout trust revoked" "$project_dir"
	;;
dev)
	run_dev
	;;
*)
	echo "usage: ${0##*/} init|event|prompt|setup|close|confirm-close|teardown|apply|trust|revoke|dev" >&2
	exit 2
	;;
esac
