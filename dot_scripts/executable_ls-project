usage() {
    echo "Ussage: ${0##*/} [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -h, --help          display this help and exit"
    echo "  -f, --full-path     display full path"
}

full_path=0
while test $# -gt 0; do
    case "$1" in
        --full-path | -f)
            full_path=1
            shift
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            usage
            exit 1
            ;;
    esac
done

(
    fd -L -u --max-depth 6 --min-depth 2 '(\.bare|\.git)$' "$PROJECTS" |
        sed -E 's,/(\.git|\.bare)/?$,,' |
        sed -E 's,/$,,'
) |
    sort |
    uniq |
    xargs -d"\n" stat -c "%Y %n" |
    sort -r |
    sed -E 's,[0-9]+\s,,' |
    if [[ $full_path -eq 0 ]]; then
        sed 's,^'"$PROJECTS/"',,g'
    else
        cat
    fi
