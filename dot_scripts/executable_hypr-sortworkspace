#!/usr/bin/env bash
#=================================================
# name:   hypr-sortworkspace
# author: Pawel Bogut <pbogut@pbogut.me>
# date:   20/02/2026
#=================================================
json=$(hyprctl activewindow -j)
class=$(echo "$json" | jq -r '.class')
title=$(echo "$json" | jq -r '.title')
current_ws=$(echo "$json" | jq -r '.workspace.name')

move_and_swich() {
  new_ws="$1"
  if [[ "$current_ws" != "$new_ws" ]]; then
    workspace=$(jq -rn --arg workspace "name:$new_ws" '$workspace | @json')
    hyprctl dispatch "hl.dsp.window.move({workspace = $workspace, follow = true})"
  fi
}


case  "$class" in
  Alacritty.project|Alacritty.herdr|Alacritty.herdr.redeye)
  move_and_swich "code"
  ;;
  vivaldi-work|brave-work|google-chrome)
  move_and_swich "work"
  ;;
  vivaldi-personal|brave-personal)
  move_and_swich "web"
  ;;
  steam|cs2|gamescope|steam_app_*)
  move_and_swich "steam"
  ;;
  webcord|WebCord|ferdium|Alacritty.mutt|Alacritty.chat)
  move_and_swich "chat"
  ;;
  *-meet.google.com__*|*-chatgpt.com__*|*-localhost__-Plannotator*)
  move_and_swich "chat"
  ;;
  *-*.zoom.us__*)
  if [[ "$class" =~ ^.*-[a-z0-9]+\.zoom\.us__.*$ ]]; then
    move_and_swich "chat"
  fi
  ;;
  *-www.youtube.com__*)
  move_and_swich "media"
  ;;
esac
