#!/usr/bin/env bash
#=================================================
# name:   chat
# author: Pawel Bogut <pbogut@pbogut.me>
# date:   09/09/2026
#=================================================
set -euo pipefail

if [[ ${TERM:-dumb} == 'dumb' && ${1:-} != 'pair' && ${1:-} != 'serve' ]]; then
  exec focus-or-exec '\.chat$' terminal -c chat -e -- chat "$@"
fi

if [[ ${1:-} == 'pair' && $# -gt 1 ]]; then
  if [[ $# -eq 2 && ($2 == '--help' || $2 == '-h') ]]; then
    printf 'Usage: chat pair\nPair a phone with the Chat server on the same network.\n'
    exit 0
  fi
  printf 'Usage: chat pair\n' >&2
  exit 1
fi

opencode_bin=$(mise which opencode --tool opencode@2)
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/opencode-chat"
server_url='http://127.0.0.1:4097'

# Share one password between clients and the systemd service.
umask 077
mkdir -p "$runtime_dir"
exec 9>"$runtime_dir/start.lock"
flock 9

if [[ ! -s $runtime_dir/password ]]; then
  openssl rand -hex 32 >"$runtime_dir/password"
fi
OPENCODE_PASSWORD=$(<"$runtime_dir/password")
export OPENCODE_PASSWORD
unset OPENCODE_CONFIG OPENCODE_CONFIG_DIR OPENCODE_CONFIG_CONTENT
unset OPENCODE_CLI_CONFIG_CONTENT OPENCODE_DB

# Release the lock before starting the service, which also reads the password.
exec 9>&-

if [[ ${1:-} == 'serve' ]]; then
  export OPENCODE_DB=chat.db
  export OPENCODE_CONFIG_CONTENT='{
    "default_agent": "chat",
    "agents": {
      "chat": { "hidden": false },
      "build": { "disabled": true },
      "plan": { "disabled": true }
    }
  }'
  exec "$opencode_bin" serve --hostname 0.0.0.0 --port 4097
fi

server_ready() {
  curl --silent --fail --max-time 1 --noproxy '*' \
    --user "opencode:$OPENCODE_PASSWORD" "$server_url/api/info" >/dev/null
}

# Upgrade an already-running localhost-only server when pairing is requested.
if [[ ${1:-} == 'pair' ]] && server_ready &&
  [[ -n $(ss -H -ltn 'src 127.0.0.1 and sport = :4097') ]]; then
  server_pid=$(curl --silent --show-error --fail --max-time 5 --noproxy '*' \
    --user "opencode:$OPENCODE_PASSWORD" "$server_url/api/info" |
    jq -er '.pid | select(type == "number" and . > 1)')
  printf 'Restarting the Chat server to allow mobile connections.\n' >&2
  kill "$server_pid"
  deadline=$((SECONDS + 30))
  while kill -0 "$server_pid" 2>/dev/null; do
    if ((SECONDS >= deadline)); then
      printf 'Timed out waiting for the Chat server to stop.\n' >&2
      exit 1
    fi
    sleep 0.2
  done
fi

if ! server_ready; then
  systemctl --user start opencode-chat.service
  deadline=$((SECONDS + 30))

  until server_ready; do
    if ((SECONDS >= deadline)); then
      printf 'Could not start the Chat server. Check journalctl --user -u opencode-chat.service\n' >&2
      exit 1
    fi
    sleep 0.2
  done
fi

if [[ ${1:-} == 'pair' ]]; then
  urls=$(curl --silent --show-error --fail --max-time 5 --noproxy '*' \
    --user "opencode:$OPENCODE_PASSWORD" "$server_url/api/info" |
    jq -ce '[.urls[] | select(test("^https?://(localhost|127\\.[0-9.]+|\\[::1\\]|0\\.0\\.0\\.0)(:|/|$)") | not)] | select(length > 0)') || {
    printf 'No network address is available for Chat pairing. Check your network connection.\n' >&2
    exit 1
  }
  pairing=$(curl --silent --show-error --fail --max-time 5 --noproxy '*' \
    --user "opencode:$OPENCODE_PASSWORD" --request POST "$server_url/api/pair")
  code=$(jq -er '.code | select(type == "string" and length > 0)' <<<"$pairing")
  expires_in=$(jq -er '.expires_in' <<<"$pairing")
  printf '\nOpen a link on your phone. It works once and expires in %s seconds.\n\n' "$expires_in"
  jq -r --arg code "$code" '.[] | rtrimstr("/") + "/auth/connect/" + ($code | @uri)' <<<"$urls"
  if command -v qrencode >/dev/null; then
    printf '\n'
    jq -nc --arg code "$code" --argjson urls "$urls" '{code: $code, urls: $urls}' |
      qrencode -t UTF8
  fi
  exit 0
fi

exec "$opencode_bin" --server "$server_url" "$@"
