#!/usr/bin/env bash
set -euo pipefail

opencode_bin=$(mise which opencode --tool opencode@2)

# Use the standard v2 config and data, including when launched from an old session.
exec env \
  -u OPENCODE_CONFIG \
  -u OPENCODE_CONFIG_DIR \
  -u OPENCODE_CONFIG_CONTENT \
  -u OPENCODE_CLI_CONFIG_CONTENT \
  -u OPENCODE_DB \
  "$opencode_bin" "$@"
