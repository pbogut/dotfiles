dnsip=$(ifconfig docker0 | awk '/inet /{print $2}')
hosts="/etc/hosts"

__clear() {
  tmpfile=$(mktemp)
  cat $hosts > "$tmpfile"
  sed "/# managed by docnet $UID$/d" "$tmpfile" > $hosts
}

__disconnet() {
  tmpfile=$(mktemp)
  cat $hosts > "$tmpfile"
  sed "/#$1# managed by docnet $UID$/d" "$tmpfile" > $hosts
}

__remove() {
  if [[ -n $1 && -n $2 && -n $3 ]]; then
    tmpfile=$(mktemp)
    cat $hosts > "$tmpfile"
    sed "/$1 $2 .*#$3# managed by docnet $UID$/d" "$tmpfile" > $hosts
  fi
}

__add() {
  if [[ -n $1 && -n $2 && -n $3 ]]; then
    __remove $1 $2 $3

    padded="$(echo $1 $2 | awk '{x=$0;for(i=length;i<70;i++)x=x " ";}END{print x}')"

    echo "$padded #$3# managed by docnet $UID" | tee -a $hosts
  fi
}

__reload_dns() {
  if systemctl is-active --quiet dnsmasq.service; then
    systemctl reload dnsmasq.service
  fi
}

__allow_tailscale_web() {
  local subnet=$1
  local -a rule=(-i tailscale0 -d "$subnet" -p tcp -m multiport --dports "80,443" -j ACCEPT)
  iptables -t raw -C PREROUTING "${rule[@]}" 2>/dev/null ||
    iptables -t raw -I PREROUTING 1 "${rule[@]}"
}

__notify_tailscale_route() {
  local operator=$1
  local subnet=$2
  local notification_file=/var/lib/docnet/tailscale-notification-id
  local uid runtime notification_id
  local -a replace

  [[ -n $operator ]] || return
  uid=$(id -u "$operator" 2>/dev/null) || return
  runtime=/run/user/$uid
  [[ -S $runtime/bus ]] || return
  [[ -f $notification_file ]] && replace=(-r "$(<"$notification_file")")

  notification_id=$(runuser -u "$operator" -- env \
    XDG_RUNTIME_DIR="$runtime" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
    dunstify -p "${replace[@]}" -u critical -t 0 -a docnet \
    "Tailscale route approval required" \
    "Approve Docker subnet $subnet for redeye in the Tailscale admin console.") || return
  [[ $notification_id =~ ^[0-9]+$ ]] && printf '%s\n' "$notification_id" > "$notification_file"
}

__close_tailscale_notification() {
  local operator=$1
  local notification_file=/var/lib/docnet/tailscale-notification-id
  local uid runtime notification_id

  [[ -n $operator && -f $notification_file ]] || return
  notification_id=$(<"$notification_file")
  uid=$(id -u "$operator" 2>/dev/null) || return
  runtime=/run/user/$uid
  [[ -S $runtime/bus ]] || return

  runuser -u "$operator" -- env \
    XDG_RUNTIME_DIR="$runtime" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
    dunstify -C "$notification_id" 2>/dev/null || true
  rm -f "$notification_file"
}

__sync_tailscale_route() {
  local subnet=$1
  local prefs operator previous route desired_csv found=false
  local state_dir=/var/lib/docnet
  local state_file=$state_dir/tailscale-external-subnet
  local -a advertised desired

  command -v tailscale >/dev/null || return
  prefs=$(tailscale debug prefs 2>/dev/null) || return
  operator=$(jq -r '.OperatorUser // empty' <<< "$prefs")
  mapfile -t advertised < <(jq -r '.AdvertiseRoutes[]?' <<< "$prefs")

  [[ -f $state_file ]] && previous=$(<"$state_file")
  for route in "${advertised[@]}"; do
    [[ -n $previous && $route == "$previous" && $route != "$subnet" ]] || desired+=("$route")
    [[ $route == "$subnet" ]] && found=true
  done
  if [[ $found == false ]]; then
    desired+=("$subnet")
  fi
  desired_csv=$(IFS=,; echo "${desired[*]}")

  if [[ $(IFS=,; echo "${advertised[*]}") != "$desired_csv" ]]; then
    if ! tailscale set --advertise-routes="$desired_csv"; then
      logger -t docnet "Unable to advertise Tailscale route $subnet"
      return
    fi
  fi

  install -d -m 0755 "$state_dir"
  printf '%s\n' "$subnet" > "$state_file"

  if tailscale status --json 2>/dev/null |
    jq -e --arg subnet "$subnet" '(.Self.PrimaryRoutes // []) | index($subnet)' >/dev/null; then
    __close_tailscale_notification "$operator"
  else
    logger -t docnet "Tailscale route $subnet is advertised but awaiting approval"
    __notify_tailscale_route "$operator" "$subnet"
  fi
}

__configure_external_access() {
  [[ $EUID == 0 ]] || return

  local subnet
  subnet=$(docker network inspect external --format '{{(index .IPAM.Config 0).Subnet}}' 2>/dev/null)
  [[ -n $subnet ]] || return

  __allow_tailscale_web "$subnet"
  __sync_tailscale_route "$subnet"
}

__connect() {
      hash=$1
      echo $hash
      inspect=$(docker inspect $hash 2>/dev/null)
      if [[ $? == 0 ]]; then
        host=$(echo $inspect | jq '.[0].Config.Hostname' -r)
        domain=$(echo $inspect | jq '.[0].Config.Domainname' -r)
        if [[ $domain == "" ]]; then
          url=$host
        else
          url=$host.$domain
        fi

        ip=$(echo "$inspect" | jq -r '.[0].NetworkSettings.Networks.external.IPAddress // empty')
        if [[ $ip == "" ]] || [[ $ip == "null" ]]; then
          ip=$(echo $inspect | jq '.[0].NetworkSettings.IPAddress' -r)
        fi
        if [[ $ip == "" ]] || [[ $ip == "null" ]]; then
          ip=$(echo $inspect |jq '.[0].NetworkSettings.Networks | map(.IPAddress) | first' -r)
        fi
        __add $ip $url $hash

        docker inspect $hash 2>/dev/null |
          jq  '.[0].NetworkSettings.Networks | map(select(.Aliases)) | map(.Aliases[])[]' -r |
          grep '\.' | while read alias; do
            __add $ip $alias $hash
          done
      fi
}

__clear

while :; do # in case something crashes we want to restart it

  # set up already started containers
  docker ps | awk '{print $1}' | while read hash; do
    hash=$(echo $hash |sed 's,^\(.\{12\}\).*,\1,')
    __connect $hash
  done
  __configure_external_access
  __reload_dns

  docker events | while read line; do
    echo $line | grep 'network \(connect\|disconnect\)' | sed 's,.*network \(disconnect\|connect\).*container=\([0-9a-z]*\)\,.*,\1 \2,' | (read action hash
      hash=$(echo $hash |sed 's,^\(.\{12\}\).*,\1,')
      if [[ $action == "connect" ]]; then
        __connect $hash
      elif [[ $action == "disconnect" ]]; then
        __disconnet $hash
      fi
      __configure_external_access
      __reload_dns
    )
  done
done
