usage() {
    echo "Ussage: ${0##*/} [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -h, --help     display this help and exit"
    echo "      --host     remote host to connect to"
}

get_free_port() {
    local port="${1:-9000}"
    local listeners

    while ((port <= 65535)); do
        if ! listeners=$(ss -H -ltn "sport = :$port"); then
            echo "Unable to inspect local TCP ports" >&2
            return 1
        fi
        if [[ -z $listeners ]]; then
            printf '%s\n' "$port"
            return 0
        fi
        ((port++))
    done

    echo "No free TCP port found at or above ${1:-9000}" >&2
    return 1
}

host=""
while test $# -gt 0; do
    case "$1" in
        --host|--host=*)
            if [[ $1 =~ --[a-z]+= ]]; then
                _val="${1//--host=/}"
                shift
            else
                _val="$2"
                shift; shift
            fi
            host="$_val"
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            usage
            exit 1
            ;;
    esac
done

port=$(get_free_port 9000) || exit 1

echo "http://localhost:$port"
echo ""
echo "Press ctrl+c to exit"

gio open "http://localhost:$port" > /dev/null 2>&1
(ssh -L "$port:localhost:8384" "$host" -t "while :; do sleep 10s; done" > /dev/null 2>&1)
