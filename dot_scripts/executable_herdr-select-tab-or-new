#!/usr/bin/env bash

if [[ ${1:-} == --restore-all ]]; then
	snapshot=$(herdr api snapshot) || exit 1
	while IFS=$'\t' read -r workspace_id role; do
		HERDR_ACTIVE_WORKSPACE_ID=$workspace_id bash "$0" "$role" --restore
	done < <(jq -r '
    def managed_role:
      if . == "nvim" or startswith("1:") then "nvim"
      elif . == "shell" or startswith("2:") then "shell"
      elif . == "shell-2" or startswith("3:") then "shell-2"
      elif . == "dev" or startswith("4:") then "dev"
      elif . == "sql" or startswith("5:") then "sql"
      elif . == "rest" or startswith("6:") then "rest"
      elif . == "git" or startswith("7:") then "git"
      elif . == "docker" or startswith("8:") then "docker"
      elif . == "opencode" or startswith("9:") then "opencode"
      elif . == "shell-3" or startswith("10:") then "shell-3"
      else null
      end;
    .result.snapshot.tabs[] |
    (.label | managed_role) as $role |
    select($role != null) |
    [.workspace_id, $role] |
    @tsv
  ' <<<"$snapshot")
	exit
fi

role=${1:?"tab role is required"}
restore_only=false
ensure_running=false
case ${2:-} in
--restore) restore_only=true ;;
--ensure-running) ensure_running=true ;;
esac
workspace_id=${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}

if [[ -z $workspace_id ]]; then
	echo "No active Herdr workspace" >&2
	exit 1
fi

socket_path=${HERDR_SOCKET_PATH:-}
if [[ -z $socket_path ]]; then
	socket_path=$(herdr status server 2>/dev/null | sed -n 's/^socket: //p')
fi

move_tab() {
	local tab_id=$1
	local insert_index=$2
	local request response

	request=$(jq -cn \
		--arg id "herdr-select-tab:$tab_id" \
		--arg tab_id "$tab_id" \
		--argjson insert_index "$insert_index" \
		'{id: $id, method: "tab.move", params: {tab_id: $tab_id, insert_index: $insert_index}}')

	response=$(python -c '
import socket
import sys

client = socket.socket(socket.AF_UNIX)
client.connect(sys.argv[1])
client.sendall((sys.argv[2] + "\n").encode())
print(client.makefile().readline(), end="")
' "$socket_path" "$request") || return

	if jq -e '.error' >/dev/null <<<"$response"; then
		jq -r '.error.message' <<<"$response" >&2
		return 1
	fi
}

sort_tabs() {
	local tabs=$1
	local index=0
	local tab_id

	while IFS= read -r tab_id; do
		move_tab "$tab_id" "$index" || return
		((index += 1))
	done < <(jq -r '
    def managed_rank:
      if . == "nvim" or startswith("1:") then 1
      elif . == "shell" or startswith("2:") then 2
      elif . == "shell-2" or startswith("3:") then 3
      elif . == "dev" or startswith("4:") then 4
      elif . == "sql" or startswith("5:") then 5
      elif . == "rest" or startswith("6:") then 6
      elif . == "git" or startswith("7:") then 7
      elif . == "docker" or startswith("8:") then 8
      elif . == "opencode" or startswith("9:") then 9
      elif . == "shell-3" or startswith("10:") then 10
      else null
      end;
    .result.tabs as $tabs |
    ([$tabs[] | select((.label | managed_rank) != null)] |
      sort_by(.label | managed_rank)) as $sorted |
    reduce $tabs[] as $tab (
      {order: [], managed_index: 0};
      if (($tab.label | managed_rank) != null) then
        .order += [$sorted[.managed_index].tab_id] |
        .managed_index += 1
      else
        .order += [$tab.tab_id]
      end
    ) |
    .order[]
  ' <<<"$tabs")
}

restore_tab() {
	local tab_id=$1
	local panes pane pane_id process_info
	local shell_name=${SHELL##*/}
	local shell_ready=false

	panes=$(herdr pane list --workspace "$workspace_id") || return 1
	pane=$(jq -c --arg tab_id "$tab_id" '
    [.result.panes[] | select(.tab_id == $tab_id)][0] // empty
  ' <<<"$panes")
	[[ -n $pane ]] || return 1

	# Official integrations own native agent resume and may still be starting asynchronously.
	if jq -e 'has("agent_session")' >/dev/null <<<"$pane"; then
		return
	fi

	pane_id=$(jq -r '.pane_id' <<<"$pane")
	for _ in {1..100}; do
		process_info=$(herdr pane process-info --pane "$pane_id") || return 1
		if jq -e --arg shell_name "$shell_name" '
      .result.process_info as $process |
      ($process.foreground_processes | length) == 1 and
      $process.foreground_processes[0].pid == $process.shell_pid and
      $process.foreground_processes[0].name == $shell_name and
      ($process.foreground_processes[0].argv | length) == 1
    ' >/dev/null <<<"$process_info"; then
			shell_ready=true
			break
		fi
		sleep 0.1
	done

	if ! $shell_ready; then
		return
	fi

	if $restore_only && [[ $role == sql || $role == rest || $role == opencode ]]; then
		herdr tab close "$tab_id" >/dev/null
		return
	fi

	if [[ -n $command ]]; then
		herdr pane run "$pane_id" "exec $command" >/dev/null
	fi
}

cache_opencode_session() {
	local session_id=$1

	[[ $session_id =~ ^[A-Za-z0-9._:-]{1,80}$ ]] || return
	herdr workspace report-metadata "$workspace_id" \
		--source plugin:pbogut.repo-metadata \
		--token "opencode_session=$session_id" >/dev/null
}

set_opencode_command() {
	local workspace session_id

	workspace=$(herdr workspace get "$workspace_id" 2>/dev/null) || return
	session_id=$(jq -r '.result.workspace.tokens.opencode_session // empty' <<<"$workspace")
	if [[ $session_id =~ ^[A-Za-z0-9._:-]{1,80}$ ]]; then
		command="opencode-launcher --session $session_id --port"
	else
		command='opencode-launcher --continue --port'
	fi
}

opencode_is_running() {
	local pane_id=$1
	local process_info

	process_info=$(herdr pane process-info --pane "$pane_id" 2>/dev/null) || return 1
	jq -e '
    any(.result.process_info.foreground_processes[]?;
      .name == "opencode" or
      any(.argv[]?; test("(^|/)(opencode|opencode-launcher)$"))
    )
  ' >/dev/null <<<"$process_info"
}

ensure_nvim_tab() {
	local tab_id=$1
	local panes pane pane_id process_info shell_name
	shell_name=${SHELL##*/}

	if HERDR_ACTIVE_WORKSPACE_ID=$workspace_id herdr-vim --ping; then
		herdr tab focus "$tab_id" >/dev/null
		return
	fi

	panes=$(herdr pane list --workspace "$workspace_id") || return 2
	pane=$(jq -c --arg tab_id "$tab_id" '
    [.result.panes[] | select(.tab_id == $tab_id)][0] // empty
  ' <<<"$panes")
	pane_id=$(jq -r '.pane_id // empty' <<<"$pane")
	[[ -n $pane_id ]] || return 1

	process_info=$(herdr pane process-info --pane "$pane_id") || return 2
	if jq -e '
    any(.result.process_info.foreground_processes[]?;
      .name == "nvim" or
      .name == "herdr-vim" or
      any(.argv[]?; test("(^|/)(nvim|herdr-vim)$"))
    )
  ' >/dev/null <<<"$process_info"; then
		herdr tab focus "$tab_id" >/dev/null
		return
	fi

	if jq -e --arg shell_name "$shell_name" '
    .result.process_info as $process |
    ($process.foreground_processes | length) == 1 and
    $process.foreground_processes[0].pid == $process.shell_pid and
    $process.foreground_processes[0].name == $shell_name and
    ($process.foreground_processes[0].argv | length) == 1
  ' >/dev/null <<<"$process_info"; then
		herdr pane run "$pane_id" "exec $command" >/dev/null || return 2
		herdr tab focus "$tab_id" >/dev/null
		return
	fi

	return 1
}

case "$role" in
nvim | 1)
	role="nvim"
	label="nvim"
	legacy_slot=1
	command="herdr-vim --start"
	;;
shell | 2)
	role="shell"
	label="shell"
	legacy_slot=2
	command=""
	;;
shell-2 | 3)
	role="shell-2"
	label="shell-2"
	legacy_slot=3
	command=""
	;;
dev | 4)
	role="dev"
	label="dev"
	legacy_slot=4
	command='zsh -ic "start-dev"'
	;;
sql | 5)
	role="sql"
	label="sql"
	legacy_slot=5
	command='zsh -ic "draft sql"'
	;;
rest | 6)
	role="rest"
	label="rest"
	legacy_slot=6
	command='zsh -ic "rest"'
	;;
git | 7)
	role="git"
	label="git"
	legacy_slot=7
	command="lazygit --use-config-file=$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/config-herdr.yml"
	;;
docker | 8)
	role="docker"
	label="docker"
	legacy_slot=8
	command="lazydocker"
	;;
opencode | 9)
	role="opencode"
	label="opencode"
	legacy_slot=9
	command='opencode-launcher --continue --port'
	;;
shell-3 | 10)
	role="shell-3"
	label="shell-3"
	legacy_slot=10
	command=""
	;;
*)
	echo "Unsupported tab role: $role" >&2
	exit 1
	;;
esac

if [[ $role == opencode ]]; then
	set_opencode_command
fi

tabs=$(herdr tab list --workspace "$workspace_id") || exit 1

tab=$(jq -c \
	--arg label "$label" \
	--arg legacy_prefix "$legacy_slot:" \
	--arg role "$role" '
  (
    [.result.tabs[] | select(.label == $label)][0] //
    [.result.tabs[] | select(.label | startswith($legacy_prefix))][0] //
    (if $role == "nvim" then
      [.result.tabs[] | select(.number == 1 and .label == "1")][0]
    else
      null
    end)
  ) // empty
' <<<"$tabs")
tab_id=$(jq -r '.tab_id // empty' <<<"$tab")

if [[ -n $tab_id ]]; then
	if [[ $(jq -r '.label' <<<"$tab") != "$label" ]]; then
		herdr tab rename "$tab_id" "$label" >/dev/null || exit 1
	fi
	if $restore_only; then
		restore_tab "$tab_id"
		exit
	fi
	if $ensure_running && [[ $role == nvim ]]; then
		ensure_nvim_tab "$tab_id"
		status=$?
		if ((status == 0)); then
			exit
		elif ((status == 2)); then
			exit 1
		fi
		herdr tab close "$tab_id" >/dev/null || exit 1
	elif [[ $role == opencode ]]; then
		panes=$(herdr pane list --workspace "$workspace_id") || exit 1
		pane=$(jq -c --arg tab_id "$tab_id" '
      [.result.panes[] | select(.tab_id == $tab_id)][0] // empty
    ' <<<"$panes")
		pane_id=$(jq -r '.pane_id // empty' <<<"$pane")
		if [[ -n $pane_id ]] && opencode_is_running "$pane_id"; then
			herdr tab focus "$tab_id" >/dev/null
			exit
		fi

		session_id=$(jq -r '
      select(.agent_session.agent == "opencode" and .agent_session.source == "herdr:opencode") |
      .agent_session.value // empty
    ' <<<"$pane")
		[[ -n $session_id ]] && cache_opencode_session "$session_id"
		herdr tab close "$tab_id" >/dev/null || exit 1
		set_opencode_command
	else
		herdr tab focus "$tab_id" >/dev/null
		exit
	fi
fi

if $restore_only; then
	exit
fi

response=$(herdr tab create \
	--workspace "$workspace_id" \
	--cwd "${HERDR_ACTIVE_PANE_CWD:-$PWD}" \
	--label "$label" \
	--focus) || exit 1

tabs=$(herdr tab list --workspace "$workspace_id")
sort_tabs "$tabs" || echo "Could not reorder Herdr tabs" >&2

if [[ -n $command ]]; then
	pane_id=$(jq -r '.result.root_pane.pane_id' <<<"$response")
	herdr pane run "$pane_id" "exec $command" >/dev/null
fi
