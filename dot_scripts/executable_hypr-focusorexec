#!/usr/bin/env bash
#=================================================
# name:   hypr-run-or-focus
# author: Pawel Bogut <pbogut@pbogut.me>
# date:   18/10/2025
#=================================================
field=class
if [[ $1 == --title ]]; then
  field=title
  shift
fi
pattern=$1
shift

selector=$(jq -rn --arg selector "$field:$pattern" '$selector | @json')
result=$(hyprctl dispatch "hl.dsp.focus({window = $selector})")
if [[ $result != "ok" ]]; then
  exec "$@"
fi
