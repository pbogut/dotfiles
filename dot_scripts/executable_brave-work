#!/usr/bin/env bash
#=================================================
# name:   chromium-start
# author: Pawel Bogut <pbogut@pbogut.me>
# date:   17/08/2024
#=================================================
if [[ -z "$*" ]]; then
    focus-or-exec "brave-work" brave \
        --ozone-platform=wayland \
        --class=brave-work \
        --user-data-dir="$HOME/.config/BraveSoftware/Work/" \
        --profile-directory=Work \
        --remote-debugging-address=127.0.0.1 \
        --remote-debugging-port=9224 \
        "$@"
else
    brave \
        --ozone-platform=wayland \
        --class=brave-work \
        --user-data-dir="$HOME/.config/BraveSoftware/Work/" \
        --profile-directory=Work \
        --remote-debugging-address=127.0.0.1 \
        --remote-debugging-port=9224 \
        "$@"
fi
